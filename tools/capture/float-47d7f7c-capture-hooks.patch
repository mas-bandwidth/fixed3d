+			}
+			exit( 0 );
+		}
 	}
 
+#if defined( __APPLE__ )
+	if ( s_headless && s_capturePath[0] != '\0' && s_frameLimit >= 0 )
+	{
+		exit( RunHeadlessCapture() );
+	}
+#endif
+
