 	RUN_SUBTEST( QuerySpawnTest );
 	RUN_SUBTEST( MeshDropTest );
 	RUN_SUBTEST( SphericalGeometryTest );
+	RUN_SUBTEST( SimdDispatchBitIdenticalTest );
 
 	return 0;
