+// Runtime CPU dispatch bit-identity probe. The wide path is compile-time today
+// (B3_SIMD_WIDTH is 4 in every configuration), so there is exactly one width to
+// run: this test asserts the detection plumbing reports the machine's AVX-512
+// capability correctly and that the ragdoll scenario produces the golden hash
+// on that width. When the runtime dispatch lands (scalar and AVX-512 paths in
+// one binary), this is the test that runs the scenario once per available width
+// and asserts the hashes are identical.
+static int SimdDispatchBitIdenticalTest( void )
+{
+	bool avx512 = b3IsAVX512Available();
+	printf( "  avx512 available: %s\n", avx512 ? "yes" : "no" );
+
+	// The detection is a pure hardware query and must be stable across calls.
+	ENSURE( b3IsAVX512Available() == avx512 );
+
+	// Run the ragdoll scenario once on the single available width and require the
+	// golden hash. This is the bit-identity control: whatever width the world
+	// runs, the state hash must match the scalar oracle. When the runtime
+	// dispatch lands (scalar and AVX-512 paths in one binary), this is the test
+	// that runs the scenario once per available width and asserts the hashes are
+	// identical.
+	DeterminismResult reference = { 0 };
+	ENSURE( SingleMultithreadingTest( 1, &reference ) == 0 );
+	ENSURE( reference.sleepStep == RAGDOLL_SLEEP_STEP );
+	ENSURE( reference.hash == RAGDOLL_HASH );
+
+	return 0;
+}
+
 int DeterminismTest( void )
 {
 	RUN_SUBTEST( RagdollHumanTest );
