 #include "simd.h"
 
+// Runtime CPU feature detection (pure integer CPUID/XGETBV). Harvested from
+// upstream box3d e77352c (PR #174, Ethan Rutherford) and re-expressed for the
+// AVX-512 fixed-point path: the feature bits are AVX512F/DQ/VL (leaf 7 EBX bits
+// 16/17/31) plus the XCR0 opmask/ZMM state bits, not leaf 7 EBX bit 5 (AVX2,
+// which has no 64x64 lane multiply and cannot express Q48.16). This is the
+// mechanism that lets one binary serve a Zen 5 box and a baseline x86-64 box:
+// the wide path is compiled in, and the scalar path is the fallback.
+
+#if defined( B3_CPU_X86_X64 )
+
+static void b3CpuId( int leaf, int subleaf, int* eax, int* ebx, int* ecx, int* edx )
+{
+	__asm__ __volatile__( "cpuid"
+						  : "=a"( *eax ), "=b"( *ebx ), "=c"( *ecx ), "=d"( *edx )
+						  : "a"( leaf ), "c"( subleaf ) );
+}
+
+static uint64_t b3GetExtendedControlRegister( void )
+{
+	uint32_t eax, edx;
+	__asm__ __volatile__( "xgetbv" : "=a"( eax ), "=d"( edx ) : "c"( 0 ) );
+	return ( (uint64_t)edx << 32 ) | eax;
+}
+
+bool b3HasAVX512( void )
+{
+	int eax, ebx, ecx, edx;
+
+	// Leaf 1: ECX bit 27 = OSXSAVE, bit 28 = AVX. Without OSXSAVE the OS does
+	// not save the AVX-512 state across context switches, so the wide path must
+	// not run.
+	b3CpuId( 1, 0, &eax, &ebx, &ecx, &edx );
+	if ( ( ecx & ( 1u << 27 ) ) == 0 || ( ecx & ( 1u << 28 ) ) == 0 )
+	{
+		return false;
+	}
+
+	// XCR0 must enable the AVX-512 state: opmask (bit 5), ZMM_hi256 (bit 6),
+	// Hi16_ZMM (bit 7).
+	uint64_t xcr0 = b3GetExtendedControlRegister();
+	if ( ( xcr0 & 0xE0 ) != 0xE0 )
+	{
+		return false;
+	}
+
+	// Leaf 7 subleaf 0: EBX bit 16 = AVX512F, bit 17 = AVX512DQ, bit 31 = AVX512VL.
+	b3CpuId( 7, 0, &eax, &ebx, &ecx, &edx );
+	if ( ( ebx & ( 1u << 16 ) ) == 0 || ( ebx & ( 1u << 17 ) ) == 0 || ( ebx & ( 1u << 31 ) ) == 0 )
+	{
+		return false;
+	}
+
+	return true;
+}
+
+#else
+
+bool b3HasAVX512( void )
+{
+	return false;
+}
+
+#endif
+
+bool b3IsAVX512Available( void )
+{
+	return b3HasAVX512();
+}
