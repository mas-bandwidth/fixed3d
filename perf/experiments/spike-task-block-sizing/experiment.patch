@@ -173,6 +173,26 @@ static int MultithreadingTest( void )
 	return 0;
 }
 
+// Block sizing must not change any result. The solver block minimums and the
+// block-count multiplier (B3_MIN_CONTACTS_PER_BLOCK, B3_MIN_JOINTS_PER_BLOCK,
+// B3_MIN_BODIES_PER_BLOCK, B3_MAX_BLOCK_COUNT_MULTIPLIER) are compile-time
+// tunables swept by the spike; constraint order and stage synchronization are
+// deterministic by construction (coloring fixes the order), so every grid cell
+// must reproduce the ragdoll hash bit-identically. This subtest is run once per
+// grid cell (each cell is a separate build with -D overrides); every cell must
+// land on RAGDOLL_HASH at workers 1-5.
+static int BlockSizingBitIdenticalTest( void )
+{
+	DeterminismResult reference = { 0 };
+	for ( int workerCount = 1; workerCount < 6; ++workerCount )
+	{
+		int result = SingleMultithreadingTest( workerCount, &reference );
+		ENSURE( result == 0 );
+	}
+
+	return 0;
+}
+
 // Test cross platform determinism.
 static int CrossPlatformTest( void )
 {
@@ -624,6 +644,7 @@ int DeterminismTest( void )
 {
 	RUN_SUBTEST( RagdollHumanTest );
 	RUN_SUBTEST( MultithreadingTest );
+	RUN_SUBTEST( BlockSizingBitIdenticalTest );
 	RUN_SUBTEST( CrossPlatformTest );
 	RUN_SUBTEST( WavePileTest );
 	RUN_SUBTEST( QuerySpawnTest );
