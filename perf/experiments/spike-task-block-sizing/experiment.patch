+// Task block sizing tunables. These are compile-time (#ifndef) so a spike can
+// sweep them with -D overrides without touching source. Block size must not
+// change any result: constraint order and stage synchronization are
+// deterministic by construction (coloring fixes the order), so these only
+// trade steal rate against cache reuse, never correctness.
+#ifndef B3_MIN_CONTACTS_PER_BLOCK
+#define B3_MIN_CONTACTS_PER_BLOCK 4
+#endif
+
+#ifndef B3_MIN_JOINTS_PER_BLOCK
+#define B3_MIN_JOINTS_PER_BLOCK 4
+#endif
+
+#ifndef B3_MIN_BODIES_PER_BLOCK
+#define B3_MIN_BODIES_PER_BLOCK 32
+#endif
+
+#ifndef B3_MAX_BLOCK_COUNT_MULTIPLIER
+#define B3_MAX_BLOCK_COUNT_MULTIPLIER 4
+#endif
+
 // these are useful for solver testing
 #define ITERATIONS 1
 #define RELAX_ITERATIONS 1
@@ -1538,15 +1559,15 @@ void b3Solve( b3World* world, b3StepContext* stepContext )
 
 		int workerCount = world->workerCount;
 
-		// Target 4 blocks per worker to allow work stealing
-		const int maxBlockCount = 4 * workerCount;
+		// Target B3_MAX_BLOCK_COUNT_MULTIPLIER blocks per worker to allow work stealing
+		const int maxBlockCount = B3_MAX_BLOCK_COUNT_MULTIPLIER * workerCount;
 
 		// Body blocks are for parallel iteration over bodies directly (integration, update transforms)
-		int minBodiesPerBlock = 32;
+		int minBodiesPerBlock = B3_MIN_BODIES_PER_BLOCK;
 		b3BlockDim bodyDim = b3ComputeBlockCount( awakeBodyCount, minBodiesPerBlock, maxBlockCount );
 
-		const int minContactsPerBlock = 4;
-		const int minJointsPerBlock = 4;
+		const int minContactsPerBlock = B3_MIN_CONTACTS_PER_BLOCK;
+		const int minJointsPerBlock = B3_MIN_JOINTS_PER_BLOCK;
 
 		// Configure blocks for tasks parallel-for each active graph color
 		// The blocks are a mix of convex contact, mesh contact, and joint blocks
diff --git a/test/test_determinism.c b/test/test_determinism.c
