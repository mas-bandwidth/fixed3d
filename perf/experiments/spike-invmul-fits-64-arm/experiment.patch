 ///
 /// Shift by the inverse's fraction bits, not by 16. Round half up, matching b3FixMul, and
 /// at 128 bits because a large inverse against a large impulse leaves 64.
+///
+/// A 64-bit arm handles the common case: the product provably fits in int64, so one
+/// hardware multiply reproduces the 128-bit path bit-for-bit (no saturation in either).
+/// The arm is taken when the leading-zero counts of the two absolute operands sum to at
+/// least 66, which guarantees |a*b| < 2^62 and therefore that a*b + 2^39 cannot reach bit
+/// 63 -- the rounding add is safe. A typical invMass of 1 (raw 2^40) against an impulse
+/// near 2^16 has a product near 2^56 and takes the 64-bit arm; an asteroid's huge inverse
+/// (up to B3_INVERSE_MAX_VALUE ~ 2^23) against an impulse near 2^20 has a product near
+/// 2^43 and also takes it. Only the range the 128-bit comment guards -- a large inverse
+/// against a large impulse whose product reaches 2^63 -- falls through.
 B3_INLINE b3Fixed b3InvMul( b3Fixed a, b3Fixed b )
 {
+	if ( a == 0 || b == 0 )
+	{
+		return 0;
+	}
+
+	uint64_t ua = a < 0 ? (uint64_t)( -( a + 1 ) ) + 1u : (uint64_t)a;
+	uint64_t ub = b < 0 ? (uint64_t)( -( b + 1 ) ) + 1u : (uint64_t)b;
+
+	if ( __builtin_clzll( ua ) + __builtin_clzll( ub ) >= 66 )
+	{
+		int64_t rounded = a * b + ( (int64_t)1 << ( B3_INVERSE_FRACTION_BITS - 1 ) );
+		return (b3Fixed)( rounded >> B3_INVERSE_FRACTION_BITS );
+	}
+
 	fixInt128 product = fixInt128MulI64( a, b );
 	fixInt128 rounded = fixInt128Add( product, fixInt128FromI64( (int64_t)1 << ( B3_INVERSE_FRACTION_BITS - 1 ) ) );
 	return (b3Fixed)fixInt128ToI64( fixInt128Shr( rounded, B3_INVERSE_FRACTION_BITS ) );
