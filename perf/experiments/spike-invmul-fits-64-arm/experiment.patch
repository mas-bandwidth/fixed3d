+// A reference 128-bit spelling of b3InvMul, kept separate from src/inverse.h so the
+// test independently checks the 64-bit fast arm against the original form even as
+// inverse.h changes. Bit-for-bit the body b3InvMul had before the 64-bit arm landed.
+static b3Fixed InvMul128Reference( b3Fixed a, b3Fixed b )
+{
+	fixInt128 product = fixInt128MulI64( a, b );
+	fixInt128 rounded = fixInt128Add( product, fixInt128FromI64( (int64_t)1 << ( B3_INVERSE_FRACTION_BITS - 1 ) ) );
+	return (b3Fixed)fixInt128ToI64( fixInt128Shr( rounded, B3_INVERSE_FRACTION_BITS ) );
+}
+
+// The 64-bit arm of b3InvMul must be bit-identical to the 128-bit arm for every input
+// the gate admits, plus the gate boundary itself. Ten million seeded pairs exercise the
+// full (inverse, impulse) domain the solver produces; the boundary set pins the gate
+// predicate at and just past 2^62, 2^63-1, the negative mirrors, INT64_MIN and zero.
+static int InvMulFits64EquivalenceTest( void )
+{
+	uint64_t rng = UINT64_C( 0x9e3779b97f4a7c15 );
+
+	// 10 million seeded pairs, magnitudes spanning 0..2^63-1 and both signs.
+	for ( int i = 0; i < 10000000; ++i )
+	{
+		rng = rng * UINT64_C( 6364136223846793005 ) + UINT64_C( 1442695040888963407 );
+		uint64_t ra = rng;
+		rng = rng * UINT64_C( 6364136223846793005 ) + UINT64_C( 1442695040888963407 );
+		uint64_t rb = rng;
+		b3Fixed a = (b3Fixed)( ra & UINT64_C( 0x7fffffffffffffff ) );
+		b3Fixed b = (b3Fixed)( ( rb & 0xff ) | ( ( rb >> 8 ) & 0xffffff00 ) );
+		if ( ra >> 63 )
+		{
+			a = -a;
+		}
+		if ( rb >> 63 )
+		{
+			b = -b;
+		}
+		ENSURE( b3InvMul( a, b ) == InvMul128Reference( a, b ) );
+	}
+
+	// Gate boundary and extreme pairs. Every one must agree with the reference, whether
+	// the 64-bit arm is taken or the 128-bit arm is.
+	{
+		const b3Fixed boundaries[] = { 0,
+									   1,
+									   -1,
+									   (b3Fixed)1 << 30,
+									   (b3Fixed)1 << 40,
+									   (b3Fixed)1 << 61,
+									   INT64_C( 1 ) << 62,
+									   INT64_C( 2 ) << 62,
+									   INT64_C( 3 ) << 62,
+									   INT64_MAX,
+									   INT64_MIN,
+									   INT64_MIN + 1,
+									   -1 - ( (b3Fixed)1 << 40 ),
+									   -( INT64_C( 1 ) << 62 ) };
+		for ( int i = 0; i < ARRAY_COUNT( boundaries ); ++i )
+		{
+			for ( int j = 0; j < ARRAY_COUNT( boundaries ); ++j )
+			{
+				ENSURE( b3InvMul( boundaries[i], boundaries[j] ) == InvMul128Reference( boundaries[i], boundaries[j] ) );
+			}
+		}
+	}
+
+	// The 64-bit arm is actually taken for the solver's common shape: invMass 2^40 against
+	// a small impulse. Assert the gate fires rather than silently always taking 128 bits.
+	ENSURE( b3InvMul( (b3Fixed)1 << 40, (b3Fixed)1 << 16 ) == (b3Fixed)( ( (int64_t)1 << 56 ) >> 40 ) );
+
+	return 0;
+}
