+// ---- Wide integrate (spike-integrate-velocities-and-positions-wide) ----------------
+//
+// Four consecutive bodies per iteration, one body per 64-bit lane of a __m256i. Every
+// fixMul is b3IntegrateMulAVX, which is contact_solver.c's b3MulLanesAVX: the exact
+// product decomposition with the same single round-half-up, so each lane is the scalar
+// b3FixMul bit for bit. Adds and subtracts are 64-bit wrapping lane ops, which equal the
+// scalar integer adds. Everything that is not a plain fixMul chain stays per-lane
+// scalar: the damping divides, b3InvMulSV/b3InvMulMV (inverse scale), b3MulQuat (fused
+// raw-128), b3Solve3 (128-bit divides) and the whole position clamp/rotation step.
+// The do-not-fuse b3InvRotateVector/b3RotateVector are reproduced in their two-cross
+// form, one rounding per product, exactly as fixed_vec.h writes them.
+
+typedef struct b3Vec3AVX
+{
+	__m256i x, y, z;
+} b3Vec3AVX;
+
+static inline __m256i b3IntegrateMulAVX( __m256i a, __m256i b )
+{
+	__m256i bh = _mm256_srai_epi64( b, B3_FIXED_FRACTION_BITS );
+	__m256i bl = _mm256_and_si256( b, _mm256_set1_epi64x( 0xFFFF ) );
+	__m256i ahi = _mm256_srai_epi64( a, 32 );
+	__m256i t = _mm256_mullo_epi64( a, bh );
+	__m256i p1 = _mm256_mul_epu32( a, bl );
+	__m256i p2 = _mm256_mul_epi32( ahi, bl );
+	__m256i low = _mm256_srli_epi64( _mm256_add_epi64( p1, _mm256_set1_epi64x( B3_FIXED_HALF ) ), B3_FIXED_FRACTION_BITS );
+	return _mm256_add_epi64( t, _mm256_add_epi64( _mm256_slli_epi64( p2, B3_FIXED_FRACTION_BITS ), low ) );
+}
+
+#define B3_IMUL( a, b ) b3IntegrateMulAVX( ( a ), ( b ) )
+#define B3_IADD( a, b ) _mm256_add_epi64( ( a ), ( b ) )
+#define B3_ISUB( a, b ) _mm256_sub_epi64( ( a ), ( b ) )
+
+static inline __m256i b3LoadLanesAVX( const b3Fixed* lanes )
+{
+	return _mm256_loadu_si256( (const __m256i*)lanes );
+}
+
+// fixCross, one rounding per product
+static inline b3Vec3AVX b3CrossAVX( b3Vec3AVX a, b3Vec3AVX b )
+{
+	b3Vec3AVX c;
+	c.x = B3_ISUB( B3_IMUL( a.y, b.z ), B3_IMUL( a.z, b.y ) );
+	c.y = B3_ISUB( B3_IMUL( a.z, b.x ), B3_IMUL( a.x, b.z ) );
+	c.z = B3_ISUB( B3_IMUL( a.x, b.y ), B3_IMUL( a.y, b.x ) );
+	return c;
+}
