+		b3Fixed speedRange = kind == 6 ? B3_FIX( 5000.0f ) : B3_FIX( 50.0f );
+		state->linearVelocity = IntegrateRandVec( &seed, speedRange );
+		state->angularVelocity = IntegrateRandVec( &seed, kind == 6 ? B3_FIX( 2000.0f ) : B3_FIX( 30.0f ) );
+		state->deltaPosition = IntegrateRandVec( &seed, B3_FIX( 2.0f ) );
+		b3Quat dq = { IntegrateRandVec( &seed, B3_FIX( 1.0f ) ), IntegrateRandFix( &seed, B3_FIX( 1.0f ) ) };
