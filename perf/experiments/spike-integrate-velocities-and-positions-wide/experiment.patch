+		sim->force = IntegrateRandVec( &seed, B3_FIX( 1000.0f ) );
+		sim->torque = IntegrateRandVec( &seed, B3_FIX( 1000.0f ) );
+		sim->invMass = kind == 7 ? B3_FIX( 0.0f ) : 1 + IntegrateRandFix( &seed, B3_FIX( 4.0f ) ) / 2 + B3_FIX( 2.0f );
