+	b3BodyState* scalarStates = calloc( bodyCount, sizeof( b3BodyState ) );
+	b3BodyState* wideStates = calloc( bodyCount, sizeof( b3BodyState ) );
+	ENSURE( sims != NULL && scalarStates != NULL && wideStates != NULL );
+
+	uint64_t seed = 0x9E3779B97F4A7C15ull;
