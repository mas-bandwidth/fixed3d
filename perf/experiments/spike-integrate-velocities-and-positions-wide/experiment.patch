+// IntegrateWideEquivalenceTest: the integrate kernels run scalar and wide (the AVX-512
+// four-body path where B3_SIMD_AVX512 is built, the scalar path otherwise) over the same
+// seeded body states and must agree byte for byte. The states cover kinematic bodies
+// (zero inverse mass), every motion lock, fast rotation, speeds that trip both clamps,
+// and a count that is not a multiple of four so the scalar tail runs too.
+static uint64_t IntegrateRng( uint64_t* s )
+{
+	uint64_t x = *s;
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	*s = x;
+	return x;
+}
+
+// A raw fixed value in [-range, range]
+static b3Fixed IntegrateRandFix( uint64_t* s, b3Fixed range )
+{
+	return (b3Fixed)( IntegrateRng( s ) % (uint64_t)( 2 * range + 1 ) ) - range;
+}
+
+static b3Vec3 IntegrateRandVec( uint64_t* s, b3Fixed range )
+{
+	return (b3Vec3){ IntegrateRandFix( s, range ), IntegrateRandFix( s, range ), IntegrateRandFix( s, range ) };
+}
+
+static int IntegrateWideEquivalenceTest( void )
+{
