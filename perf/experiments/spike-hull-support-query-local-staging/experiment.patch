+	b3BoxHull limb = b3MakeBoxHull( B3_FIX( 0.5f ), B3_FIX( 0.15f ), B3_FIX( 0.15f ) );
+
+	b3Vec3 tetraPoints[4] = {
+		{ B3_FIX( 1.0f ), B3_FIX( 0.0f ), B3_FIX( 0.0f ) },
+		{ -B3_FIX( 1.0f ), B3_FIX( 0.0f ), B3_FIX( 0.0f ) },
+		{ B3_FIX( 0.0f ), B3_FIX( 1.0f ), B3_FIX( 0.0f ) },
+		{ B3_FIX( 0.0f ), B3_FIX( 0.0f ), B3_FIX( 1.0f ) },
+	};
+	b3HullData* tetra = b3CreateHull( tetraPoints, 4, 4 );
+
+	enum { SPHERE_SAMPLE_N = 128 };
+	b3Vec3 spherePoints[SPHERE_SAMPLE_N];
+	FillSphereSample( spherePoints, SPHERE_SAMPLE_N, 12345u );
+	// The half-edge index is uint8 (256 half-edges), so a fully-triangulated
+	// sphere is capped near 44 vertices: 128 input points reduce to a 32-vertex
+	// hull, the largest the cooker admits (F = 2M-4 = 60, E = 3M-6 = 90).
+	b3HullData* sphere = b3CreateHull( spherePoints, SPHERE_SAMPLE_N, 32 );
+
+	ENSURE( tetra != NULL );
+	ENSURE( sphere != NULL );
+
+	b3HullData* hulls[4] = { &box.base, tetra, sphere, &limb.base };
+
+	// Exact-tie directions first: axis-aligned ties whole faces of a box, and
+	// diagonal directions tie faces (dot(1,1,0) with +x and +y normals) and
+	// edges of the sphere hulls.
+	b3Vec3 tieDirs[13] = {
+		{ B3_FIX( 1.0f ), B3_FIX( 0.0f ), B3_FIX( 0.0f ) },  { -B3_FIX( 1.0f ), B3_FIX( 0.0f ), B3_FIX( 0.0f ) },
+		{ B3_FIX( 0.0f ), B3_FIX( 1.0f ), B3_FIX( 0.0f ) },  { B3_FIX( 0.0f ), -B3_FIX( 1.0f ), B3_FIX( 0.0f ) },
+		{ B3_FIX( 0.0f ), B3_FIX( 0.0f ), B3_FIX( 1.0f ) },  { B3_FIX( 0.0f ), B3_FIX( 0.0f ), -B3_FIX( 1.0f ) },
+		{ B3_FIX( 1.0f ), B3_FIX( 1.0f ), B3_FIX( 0.0f ) },  { B3_FIX( 1.0f ), B3_FIX( 0.0f ), B3_FIX( 1.0f ) },
+		{ B3_FIX( 0.0f ), B3_FIX( 1.0f ), B3_FIX( 1.0f ) },  { B3_FIX( 1.0f ), B3_FIX( 1.0f ), B3_FIX( 1.0f ) },
+		{ B3_FIX( 1.0f ), -B3_FIX( 1.0f ), B3_FIX( 0.0f ) }, { B3_FIX( 1.0f ), B3_FIX( 0.0f ), -B3_FIX( 1.0f ) },
+		{ B3_FIX( 0.0f ), B3_FIX( 1.0f ), -B3_FIX( 1.0f ) },
