+// ---------------------------------------------------------------------------
+// spike-hull-support-query-local-staging. The staged SoA support scans must be
+// bit-identical to the existing scans: same vertex index AND face index for
+// every direction, including exact ties (directions orthogonal to a box edge or
+// face, and diagonal directions that tie two faces). The stage is built once per
+// hull and scanned over 100,000 seeded directions covering tiny (wide-path) and
+// huge (exact-scalar-path) magnitudes.
+// ---------------------------------------------------------------------------
+static void StageNextDirection( uint32_t* seed, int magnitudeClass, b3Vec3* d )
+{
+	b3Fixed c[3];
+	for ( int k = 0; k < 3; ++k )
+	{
+		*seed ^= *seed << 13;
+		*seed ^= *seed >> 17;
+		*seed ^= *seed << 5;
+		c[k] = (b3Fixed)b3FixFromInt( (int)( ( *seed & 0x7fffu ) - 0x4000u ) );
+	}
+	d->x = c[0];
+	d->y = c[1];
+	d->z = c[2];
+	// Scale so the run covers the wide (int64/int32 exact) scan and the exact
+	// AoS fallback: tiny directions stay admissible, huge ones force the fallback.
+	b3Fixed scale = B3_FIX( 1.0f );
+	if ( magnitudeClass == 1 )
+	{
+		scale = (b3Fixed)1 << 20;
+	}
+	else if ( magnitudeClass == 2 )
+	{
+		scale = B3_FIXED_EPSILON;
+	}
+	d->x = b3FixMul( d->x, scale );
+	d->y = b3FixMul( d->y, scale );
+	d->z = b3FixMul( d->z, scale );
+}
