+// ---------------------------------------------------------------------------
+// spike-hull-support-query-local-staging: a caller-owned (stack) SoA stage of a
+// hull's vertex xyz and face normals. The face-SAT loop scans hull B's support
+// vertex once per face; staging de-swizzles the AoS points into wide SoA lanes
+// ONCE per query and each face scan reads the stage, instead of re-de-swizzling
+// (vuzp1q_s32 + vqtbl3q_u8 on NEON, permutex2var on AVX-512) on every call.
+//
+// The lane type follows the same per-ISA rule as b3EdgeLane: int64 on AVX-512
+// (direct 64-bit lane multiply) and scalar, int32 on NEON (smull/smlal widening
+// multiply). Staging is lossless only when every component fits the lane type;
+// when it does not (NEON rejects components >= 2^31), the count field is left 0
+// and the staged scan falls back to the exact AoS path, so results stay
+// bit-identical to b3FindHullSupportVertex / b3FindHullSupportFace for every
+// input. No allocation, no cross-stage ownership: the stage lives on the query
+// stack frame and is discarded with it.
+// ---------------------------------------------------------------------------
+#if defined( B3_SIMD_NEON )
+typedef int32_t b3SupportLane;
+#else
+typedef b3Fixed b3SupportLane;
+#endif
+
+typedef struct b3HullSupportStage
+{
+	b3SupportLane px[B3_MAX_HULL_VERTICES];
+	b3SupportLane py[B3_MAX_HULL_VERTICES];
+	b3SupportLane pz[B3_MAX_HULL_VERTICES];
+	b3SupportLane nx[B3_MAX_HULL_FACES];
+	b3SupportLane ny[B3_MAX_HULL_FACES];
+	b3SupportLane nz[B3_MAX_HULL_FACES];
+	int vertexCount;
+	int faceCount;
+	uint64_t vertexBound;
+} b3HullSupportStage;
+
+void b3StageHullSupport( const b3HullData* hull, b3HullSupportStage* stage );
+
+// Identical result to b3FindHullSupportVertex / b3FindHullSupportFace (exact
+// raw-128 dots, first-wins tie rule). Fall back to the exact AoS scan when the
+// stage is not usable for the given direction.
+int b3FindHullSupportVertexStaged( const b3HullData* hull, const b3HullSupportStage* stage, b3Vec3 direction );
