+// ---------------------------------------------------------------------------
+// spike-hull-support-query-local-staging. Stage the AoS points/normals into SoA
+// lanes once per query; the per-face scan reads the stage. Results are
+// bit-identical to the existing scans: same exact raw-128 dots, same first-wins
+// tie rule, same scalar tail. See hull.h.
+// ---------------------------------------------------------------------------
+
+void b3StageHullSupport( const b3HullData* hull, b3HullSupportStage* stage )
+{
+	int vertexCount = hull->vertexCount;
+	int faceCount = hull->faceCount;
+	const b3Vec3* points = b3GetHullPoints( hull );
+	const b3Plane* planes = b3GetHullPlanes( hull );
+
+	stage->vertexCount = 0;
+	stage->faceCount = 0;
+
+#if defined( B3_SIMD_AVX512 ) || defined( B3_SIMD_NEON )
+	// Same operand bound as b3FindHullSupportVertex: every |vertex component| is
+	// bounded by the hull's local AABB (the cooker computes it from the points).
+	stage->vertexBound = b3AbsBoundU64( hull->aabb.lowerBound.x );
+	uint64_t candidates[5] = { b3AbsBoundU64( hull->aabb.lowerBound.y ), b3AbsBoundU64( hull->aabb.lowerBound.z ),
+							   b3AbsBoundU64( hull->aabb.upperBound.x ), b3AbsBoundU64( hull->aabb.upperBound.y ),
+							   b3AbsBoundU64( hull->aabb.upperBound.z ) };
+	for ( int i = 0; i < 5; ++i )
+	{
+		stage->vertexBound = candidates[i] > stage->vertexBound ? candidates[i] : stage->vertexBound;
+	}
+#endif
+
+#if defined( B3_SIMD_NEON )
+	// NEON narrows to int32: the stage is only valid when every vertex component
+	// fits int32, otherwise the truncated values are never read (vertexCount 0).
+	bool vertexFits = true;
+	for ( int i = 0; i < vertexCount; ++i )
+	{
+		if ( points[i].x >= ( (b3Fixed)1 << 31 ) || points[i].x < -( (b3Fixed)1 << 31 ) || points[i].y >= ( (b3Fixed)1 << 31 ) ||
+			 points[i].y < -( (b3Fixed)1 << 31 ) || points[i].z >= ( (b3Fixed)1 << 31 ) || points[i].z < -( (b3Fixed)1 << 31 ) )
+		{
+			vertexFits = false;
+			break;
+		}
+	}
+	if ( vertexFits )
+	{
+		for ( int i = 0; i < vertexCount; ++i )
+		{
+			stage->px[i] = (b3SupportLane)points[i].x;
+			stage->py[i] = (b3SupportLane)points[i].y;
+			stage->pz[i] = (b3SupportLane)points[i].z;
+		}
+		stage->vertexCount = vertexCount;
+	}
+#else
+	// int64 lanes hold the full b3Fixed range: always stageable.
+	for ( int i = 0; i < vertexCount; ++i )
+	{
+		stage->px[i] = (b3SupportLane)points[i].x;
+		stage->py[i] = (b3SupportLane)points[i].y;
+		stage->pz[i] = (b3SupportLane)points[i].z;
+	}
+	stage->vertexCount = vertexCount;
+#endif
+
+	// Face normals are validated unit vectors (|component| <= B3_FIXED_ONE), so
+	// they always fit int32 and int64.
+	for ( int i = 0; i < faceCount; ++i )
+	{
+		stage->nx[i] = (b3SupportLane)planes[i].normal.x;
+		stage->ny[i] = (b3SupportLane)planes[i].normal.y;
+		stage->nz[i] = (b3SupportLane)planes[i].normal.z;
+	}
+	stage->faceCount = faceCount;
+}
+
+#if defined( B3_SIMD_AVX512 )
+
+// Argmax of dot(direction, p) over SoA int64 lanes; the caller has proven
+// b3WideScanAdmissible so the int64 dots are exact.
+static int b3FindSupportVertexLanesSoA( const b3SupportLane* x, const b3SupportLane* y, const b3SupportLane* z, int count,
+										b3Vec3 direction )
+{
+	__m256i dirX = _mm256_set1_epi64x( direction.x );
+	__m256i dirY = _mm256_set1_epi64x( direction.y );
+	__m256i dirZ = _mm256_set1_epi64x( direction.z );
+
+	__m256i bestVal = _mm256_setzero_si256();
+	__m256i bestIdx = _mm256_setzero_si256();
+	__m256i curIdx = _mm256_setr_epi64x( 0, 1, 2, 3 );
+	const __m256i four = _mm256_set1_epi64x( 4 );
+
+	int groupCount = count / 4;
+	for ( int group = 0; group < groupCount; ++group )
+	{
+		__m256i px = _mm256_loadu_si256( (const __m256i*)( x + 4 * group ) );
+		__m256i py = _mm256_loadu_si256( (const __m256i*)( y + 4 * group ) );
+		__m256i pz = _mm256_loadu_si256( (const __m256i*)( z + 4 * group ) );
+
+		__m256i dot = _mm256_add_epi64( _mm256_add_epi64( _mm256_mullo_epi64( dirX, px ), _mm256_mullo_epi64( dirY, py ) ),
+										_mm256_mullo_epi64( dirZ, pz ) );
+
+		if ( group == 0 )
+		{
+			bestVal = dot;
+			bestIdx = curIdx;
+		}
+		else
+		{
+			__mmask8 greater = _mm256_cmpgt_epi64_mask( dot, bestVal );
+			bestVal = _mm256_mask_blend_epi64( greater, bestVal, dot );
+			bestIdx = _mm256_mask_blend_epi64( greater, bestIdx, curIdx );
+		}
+		curIdx = _mm256_add_epi64( curIdx, four );
+	}
+
+	int64_t vals[4], idxs[4];
+	_mm256_storeu_si256( (__m256i*)vals, bestVal );
+	_mm256_storeu_si256( (__m256i*)idxs, bestIdx );
+	int bestIndex = (int)idxs[0];
+	b3Int128 bestDot = vals[0];
+	for ( int lane = 1; lane < 4; ++lane )
+	{
+		if ( vals[lane] > bestDot || ( vals[lane] == bestDot && idxs[lane] < bestIndex ) )
+		{
+			bestDot = vals[lane];
+			bestIndex = (int)idxs[lane];
+		}
+	}
+
+	for ( int index = 4 * groupCount; index < count; ++index )
+	{
+		b3Int128 dot = b3DotRaw( direction, (b3Vec3){ (b3Fixed)x[index], (b3Fixed)y[index], (b3Fixed)z[index] } );
+		if ( dot > bestDot )
+		{
+			bestDot = dot;
+			bestIndex = index;
+		}
+	}
+
+	return bestIndex;
+}
+
+// Argmax of dot(direction, n) over SoA int64 face normals.
+static int b3FindSupportFaceLanesSoA( const b3SupportLane* x, const b3SupportLane* y, const b3SupportLane* z, int count,
+									  b3Vec3 direction )
+{
+	__m256i dirX = _mm256_set1_epi64x( direction.x );
+	__m256i dirY = _mm256_set1_epi64x( direction.y );
+	__m256i dirZ = _mm256_set1_epi64x( direction.z );
+
+	__m256i bestVal = _mm256_setzero_si256();
+	__m256i bestIdx = _mm256_setzero_si256();
+	__m256i curIdx = _mm256_setr_epi64x( 0, 1, 2, 3 );
+	const __m256i four = _mm256_set1_epi64x( 4 );
+
+	int groupCount = count / 4;
+	for ( int group = 0; group < groupCount; ++group )
+	{
+		__m256i nx = _mm256_loadu_si256( (const __m256i*)( x + 4 * group ) );
+		__m256i ny = _mm256_loadu_si256( (const __m256i*)( y + 4 * group ) );
+		__m256i nz = _mm256_loadu_si256( (const __m256i*)( z + 4 * group ) );
+
+		__m256i dot = _mm256_add_epi64( _mm256_add_epi64( _mm256_mullo_epi64( dirX, nx ), _mm256_mullo_epi64( dirY, ny ) ),
+										_mm256_mullo_epi64( dirZ, nz ) );
+
+		if ( group == 0 )
+		{
+			bestVal = dot;
+			bestIdx = curIdx;
+		}
+		else
+		{
+			__mmask8 greater = _mm256_cmpgt_epi64_mask( dot, bestVal );
+			bestVal = _mm256_mask_blend_epi64( greater, bestVal, dot );
+			bestIdx = _mm256_mask_blend_epi64( greater, bestIdx, curIdx );
+		}
+		curIdx = _mm256_add_epi64( curIdx, four );
+	}
+
+	int64_t vals[4], idxs[4];
+	_mm256_storeu_si256( (__m256i*)vals, bestVal );
+	_mm256_storeu_si256( (__m256i*)idxs, bestIdx );
+	int bestIndex = (int)idxs[0];
+	b3Int128 bestDot = vals[0];
+	for ( int lane = 1; lane < 4; ++lane )
+	{
+		if ( vals[lane] > bestDot || ( vals[lane] == bestDot && idxs[lane] < bestIndex ) )
+		{
+			bestDot = vals[lane];
+			bestIndex = (int)idxs[lane];
+		}
+	}
+
+	for ( int index = 4 * groupCount; index < count; ++index )
+	{
+		b3Int128 dot = b3DotRaw( direction, (b3Vec3){ (b3Fixed)x[index], (b3Fixed)y[index], (b3Fixed)z[index] } );
+		if ( dot > bestDot )
+		{
+			bestDot = dot;
+			bestIndex = index;
+		}
+	}
+
+	return bestIndex;
+}
+
+#elif defined( B3_SIMD_NEON )
+
+// Argmax of dot(direction, p) over SoA int32 lanes with smull/smlal; the caller
+// has proven every operand fits int32 and every dot fits int64. No de-swizzle:
+// the SoA columns are loaded directly.
+static int b3FindSupportVertexLanesSoA( const b3SupportLane* x, const b3SupportLane* y, const b3SupportLane* z, int count,
+										b3Vec3 direction )
+{
+	int32x2_t dirX2 = vdup_n_s32( (int32_t)direction.x );
+	int32x2_t dirY2 = vdup_n_s32( (int32_t)direction.y );
+	int32x2_t dirZ2 = vdup_n_s32( (int32_t)direction.z );
+	int32x4_t dirX4 = vdupq_n_s32( (int32_t)direction.x );
+	int32x4_t dirY4 = vdupq_n_s32( (int32_t)direction.y );
+	int32x4_t dirZ4 = vdupq_n_s32( (int32_t)direction.z );
+
+	b3ArgmaxNEON state;
+	const int64_t initLo[2] = { 0, 1 };
+	const int64_t initHi[2] = { 2, 3 };
+	int64x2_t curLo = vld1q_s64( initLo );
+	int64x2_t curHi = vld1q_s64( initHi );
+	int64x2_t four = vdupq_n_s64( 4 );
+
+	int groupCount = count / 4;
+	for ( int group = 0; group < groupCount; ++group )
+	{
+		int32x4_t px = vld1q_s32( x + 4 * group );
+		int32x4_t py = vld1q_s32( y + 4 * group );
+		int32x4_t pz = vld1q_s32( z + 4 * group );
+
+		int64x2_t dotLo = vmull_s32( vget_low_s32( px ), dirX2 );
+		dotLo = vmlal_s32( dotLo, vget_low_s32( py ), dirY2 );
+		dotLo = vmlal_s32( dotLo, vget_low_s32( pz ), dirZ2 );
+		int64x2_t dotHi = vmull_high_s32( px, dirX4 );
+		dotHi = vmlal_high_s32( dotHi, py, dirY4 );
+		dotHi = vmlal_high_s32( dotHi, pz, dirZ4 );
+
+		if ( group == 0 )
+		{
+			state.bestLo = dotLo;
+			state.bestHi = dotHi;
+			state.idxLo = curLo;
+			state.idxHi = curHi;
+		}
+		else
+		{
+			b3ArgmaxStepNEON( &state, dotLo, dotHi, curLo, curHi );
+		}
+		curLo = vaddq_s64( curLo, four );
+		curHi = vaddq_s64( curHi, four );
+	}
+
+	b3Int128 bestDot;
+	int bestIndex = b3ArgmaxReduceNEON( &state, &bestDot );
+
+	for ( int index = 4 * groupCount; index < count; ++index )
+	{
+		b3Int128 dot = b3DotRaw( direction, (b3Vec3){ (b3Fixed)x[index], (b3Fixed)y[index], (b3Fixed)z[index] } );
+		if ( dot > bestDot )
+		{
+			bestDot = dot;
+			bestIndex = index;
+		}
+	}
+
+	return bestIndex;
+}
+
+// Argmax of dot(direction, n) over SoA int32 face normals.
+static int b3FindSupportFaceLanesSoA( const b3SupportLane* x, const b3SupportLane* y, const b3SupportLane* z, int count,
+									  b3Vec3 direction )
+{
+	int32x2_t dirX2 = vdup_n_s32( (int32_t)direction.x );
+	int32x2_t dirY2 = vdup_n_s32( (int32_t)direction.y );
+	int32x2_t dirZ2 = vdup_n_s32( (int32_t)direction.z );
+	int32x4_t dirX4 = vdupq_n_s32( (int32_t)direction.x );
+	int32x4_t dirY4 = vdupq_n_s32( (int32_t)direction.y );
+	int32x4_t dirZ4 = vdupq_n_s32( (int32_t)direction.z );
+
+	b3ArgmaxNEON state;
+	const int64_t initLo[2] = { 0, 1 };
+	const int64_t initHi[2] = { 2, 3 };
+	int64x2_t curLo = vld1q_s64( initLo );
+	int64x2_t curHi = vld1q_s64( initHi );
+	int64x2_t four = vdupq_n_s64( 4 );
+
+	int groupCount = count / 4;
+	for ( int group = 0; group < groupCount; ++group )
+	{
+		int32x4_t nx = vld1q_s32( x + 4 * group );
+		int32x4_t ny = vld1q_s32( y + 4 * group );
+		int32x4_t nz = vld1q_s32( z + 4 * group );
+
+		int64x2_t dotLo = vmull_s32( vget_low_s32( nx ), dirX2 );
+		dotLo = vmlal_s32( dotLo, vget_low_s32( ny ), dirY2 );
+		dotLo = vmlal_s32( dotLo, vget_low_s32( nz ), dirZ2 );
+		int64x2_t dotHi = vmull_high_s32( nx, dirX4 );
+		dotHi = vmlal_high_s32( dotHi, ny, dirY4 );
+		dotHi = vmlal_high_s32( dotHi, nz, dirZ4 );
+
+		if ( group == 0 )
+		{
+			state.bestLo = dotLo;
+			state.bestHi = dotHi;
+			state.idxLo = curLo;
+			state.idxHi = curHi;
+		}
+		else
+		{
+			b3ArgmaxStepNEON( &state, dotLo, dotHi, curLo, curHi );
+		}
+		curLo = vaddq_s64( curLo, four );
+		curHi = vaddq_s64( curHi, four );
+	}
+
+	b3Int128 bestDot;
+	int bestIndex = b3ArgmaxReduceNEON( &state, &bestDot );
+
+	for ( int index = 4 * groupCount; index < count; ++index )
+	{
+		b3Int128 dot = b3DotRaw( direction, (b3Vec3){ (b3Fixed)x[index], (b3Fixed)y[index], (b3Fixed)z[index] } );
+		if ( dot > bestDot )
+		{
+			bestDot = dot;
+			bestIndex = index;
+		}
+	}
+
+	return bestIndex;
+}
+
+#else
+
+// Scalar SoA scans: same raw-128 dot loop as the AoS scan, reading the stage
+// columns directly. Bit-identical by construction (int64 lanes hold the full
+// b3Fixed range).
+static int b3FindSupportVertexLanesSoA( const b3SupportLane* x, const b3SupportLane* y, const b3SupportLane* z, int count,
+										b3Vec3 direction )
+{
+	int bestIndex = B3_NULL_INDEX;
+	b3Int128 bestDot = 0;
+	for ( int index = 0; index < count; ++index )
+	{
+		b3Int128 dot = b3DotRaw( direction, (b3Vec3){ (b3Fixed)x[index], (b3Fixed)y[index], (b3Fixed)z[index] } );
+		if ( bestIndex == B3_NULL_INDEX || dot > bestDot )
+		{
+			bestDot = dot;
+			bestIndex = index;
+		}
+	}
+	return bestIndex;
+}
+
+static int b3FindSupportFaceLanesSoA( const b3SupportLane* x, const b3SupportLane* y, const b3SupportLane* z, int count,
+									  b3Vec3 direction )
+{
+	int bestIndex = B3_NULL_INDEX;
+	b3Int128 bestDot = 0;
+	for ( int index = 0; index < count; ++index )
+	{
+		b3Int128 dot = b3DotRaw( direction, (b3Vec3){ (b3Fixed)x[index], (b3Fixed)y[index], (b3Fixed)z[index] } );
+		if ( bestIndex == B3_NULL_INDEX || dot > bestDot )
+		{
+			bestDot = dot;
+			bestIndex = index;
+		}
+	}
+	return bestIndex;
+}
+
+#endif
+
+int b3FindHullSupportVertexStaged( const b3HullData* hull, const b3HullSupportStage* stage, b3Vec3 direction )
+{
+#if defined( B3_SIMD_AVX512 ) || defined( B3_SIMD_NEON )
+	if ( stage->vertexCount >= 4 && b3WideScanAdmissible( direction, stage->vertexBound ) )
+	{
+		int bestIndex = b3FindSupportVertexLanesSoA( stage->px, stage->py, stage->pz, stage->vertexCount, direction );
+		B3_ASSERT( 0 <= bestIndex && bestIndex < stage->vertexCount );
+		return bestIndex;
+	}
+	return b3FindHullSupportVertex( hull, direction );
+#else
+	(void)hull;
+	return b3FindSupportVertexLanesSoA( stage->px, stage->py, stage->pz, stage->vertexCount, direction );
+#endif
+}
+
+int b3FindHullSupportFaceStaged( const b3HullData* hull, const b3HullSupportStage* stage, b3Vec3 direction )
+{
+#if defined( B3_SIMD_AVX512 ) || defined( B3_SIMD_NEON )
+	if ( stage->faceCount >= 4 && b3WideScanAdmissible( direction, (uint64_t)( 4 * B3_FIXED_ONE ) ) )
+	{
+		int bestIndex = b3FindSupportFaceLanesSoA( stage->nx, stage->ny, stage->nz, stage->faceCount, direction );
+		B3_ASSERT( 0 <= bestIndex && bestIndex < stage->faceCount );
+		return bestIndex;
+	}
+	return b3FindHullSupportFace( hull, direction );
+#else
+	(void)hull;
+	return b3FindSupportFaceLanesSoA( stage->nx, stage->ny, stage->nz, stage->faceCount, direction );
+#endif
+}
+
