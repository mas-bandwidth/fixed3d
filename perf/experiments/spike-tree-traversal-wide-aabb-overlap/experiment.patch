+// Seeded LCG (the b3CreateComplexHullSeeded constants) for deterministic boxes.
+static uint32_t s_treeRng;
+static uint32_t TreeRngNext( void )
+{
+	s_treeRng = s_treeRng * 2147001325u + 715136305u;
+	return s_treeRng;
+}
+
+// Scalar reference traversal: a copy of the pre-wide b3DynamicTree_Query visit order
+// (push child1 then child2, pop child2 first, scalar b3AABB_Overlaps per node).
+static int ScalarQueryReference( const b3DynamicTree* tree, b3AABB aabb, uint64_t maskBits, bool requireAllBits, int* outIds,
+								 int maxOut )
+{
+	int stack[1024];
+	int stackCount = 0;
+	stack[stackCount++] = tree->root;
+	int count = 0;
+	while ( stackCount > 0 )
+	{
+		int nodeId = stack[--stackCount];
+		const b3TreeNode* node = tree->nodes + nodeId;
+		uint64_t bitMatch = requireAllBits ? ( node->categoryBits & maskBits ) == maskBits : ( node->categoryBits & maskBits );
+		if ( bitMatch && b3AABB_Overlaps( node->aabb, aabb ) )
+		{
+			if ( node->flags & b3_leafNode )
+			{
+				if ( count < maxOut )
+				{
+					outIds[count++] = nodeId;
+				}
+			}
+			else
+			{
+				stack[stackCount++] = node->children.child1;
+				stack[stackCount++] = node->children.child2;
+			}
+		}
+	}
+	return count;
+}
+
+typedef struct TreeQueryCollect
+{
+	int* ids;
+	int count;
+	int capacity;
+} TreeQueryCollect;
+
+static bool TreeQueryCollectCallback( int proxyId, uint64_t userData, void* context )
+{
+	B3_UNUSED( userData );
+	TreeQueryCollect* c = (TreeQueryCollect*)context;
+	if ( c->count < c->capacity )
+	{
+		c->ids[c->count++] = proxyId;
+	}
+	return true;
+}
+
+// The wide tree query must return the same SEQUENCE of proxy ids as the scalar
+// traversal (not just the same set): the broad phase pair finder depends on the
+// visit order for deterministic contact creation.
+static int TreeQueryWideEquivalenceTest( void )
+{
+	enum
+	{
+		BOX_COUNT = 20000,
+		QUERY_COUNT = 1000
+	};
+
+	b3DynamicTree tree = b3DynamicTree_Create( BOX_COUNT );
+
+	s_treeRng = 42;
+
+	for ( int i = 0; i < BOX_COUNT; ++i )
+	{
+		b3Fixed cx = (b3Fixed)( (int64_t)( TreeRngNext() % 2000001u ) - 1000000 );
+		b3Fixed cy = (b3Fixed)( (int64_t)( TreeRngNext() % 2000001u ) - 1000000 );
+		b3Fixed cz = (b3Fixed)( (int64_t)( TreeRngNext() % 2000001u ) - 1000000 );
+		b3Fixed hx = (b3Fixed)( (int64_t)( TreeRngNext() % 100000u ) + 1 );
+		b3Fixed hy = (b3Fixed)( (int64_t)( TreeRngNext() % 100000u ) + 1 );
+		b3Fixed hz = (b3Fixed)( (int64_t)( TreeRngNext() % 100000u ) + 1 );
+		b3AABB aabb = {
+			.lowerBound = { cx - hx, cy - hy, cz - hz },
+			.upperBound = { cx + hx, cy + hy, cz + hz },
+		};
+		b3DynamicTree_CreateProxy( &tree, aabb, B3_DEFAULT_CATEGORY_BITS, (uint64_t)i );
+	}
+
+	int* wideIds = (int*)malloc( BOX_COUNT * sizeof( int ) );
+	int* scalarIds = (int*)malloc( BOX_COUNT * sizeof( int ) );
+
+	for ( int q = 0; q < QUERY_COUNT; ++q )
+	{
+		b3Fixed cx = (b3Fixed)( (int64_t)( TreeRngNext() % 2000001u ) - 1000000 );
+		b3Fixed cy = (b3Fixed)( (int64_t)( TreeRngNext() % 2000001u ) - 1000000 );
+		b3Fixed cz = (b3Fixed)( (int64_t)( TreeRngNext() % 2000001u ) - 1000000 );
+		b3Fixed hx = (b3Fixed)( (int64_t)( TreeRngNext() % 200000u ) + 1 );
+		b3Fixed hy = (b3Fixed)( (int64_t)( TreeRngNext() % 200000u ) + 1 );
+		b3Fixed hz = (b3Fixed)( (int64_t)( TreeRngNext() % 200000u ) + 1 );
+		b3AABB query = {
+			.lowerBound = { cx - hx, cy - hy, cz - hz },
+			.upperBound = { cx + hx, cy + hy, cz + hz },
+		};
+
+		TreeQueryCollect collect = { wideIds, 0, BOX_COUNT };
+		b3DynamicTree_Query( &tree, query, B3_DEFAULT_MASK_BITS, false, TreeQueryCollectCallback, &collect );
+
+		int scalarCount = ScalarQueryReference( &tree, query, B3_DEFAULT_MASK_BITS, false, scalarIds, BOX_COUNT );
+
+		ENSURE( collect.count == scalarCount );
+		for ( int i = 0; i < collect.count; ++i )
+		{
+			ENSURE( wideIds[i] == scalarIds[i] );
+		}
+	}
+
+	free( wideIds );
+	free( scalarIds );
+	b3DynamicTree_Destroy( &tree );
+
+	return 0;
+}
