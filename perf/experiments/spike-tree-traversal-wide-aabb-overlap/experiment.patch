+// Wide overlap test for two child AABBs against a query AABB, in one SIMD compare.
+// The overlap predicate is six exact integer comparisons per child (three axes, two
+// directions each), so it needs no multiply and is bit-identical to the scalar
+// b3AABB_Overlaps. Four int64 lanes hold the two children's two separations per axis.
+// Returns a 2-bit mask: bit 0 = child1 overlaps, bit 1 = child2 overlaps.
+//
+// Ludicrous mode is excluded: bounds are int128 there and packed int64 loads would
+// scramble bytes (the CLAUDE.md bound bug class). The narrow build's b3AABB is six
+// contiguous int64, so the loads are exact.
+#if defined( B3_SIMD_AVX512 ) && !defined( BOX3D_LUDICROUS_MODE )
+#include <immintrin.h>
+
+static inline int b3WideOverlap2( b3AABB a1, b3AABB a2, b3AABB b )
+{
+	// Per axis, lane layout (child1 separations, then child2 separations):
+	//   lane0 = a1.lower - b.upper   (a1 separated if > 0)
+	//   lane1 = b.lower - a1.upper   (a1 separated if > 0)
+	//   lane2 = a2.lower - b.upper   (a2 separated if > 0)
+	//   lane3 = b.lower - a2.upper   (a2 separated if > 0)
+	__m256i ax = _mm256_set_epi64x( b.lowerBound.x, a2.lowerBound.x, b.lowerBound.x, a1.lowerBound.x );
+	__m256i bx = _mm256_set_epi64x( a2.upperBound.x, b.upperBound.x, a1.upperBound.x, b.upperBound.x );
+	__m256i sx = _mm256_sub_epi64( ax, bx );
+
+	__m256i ay = _mm256_set_epi64x( b.lowerBound.y, a2.lowerBound.y, b.lowerBound.y, a1.lowerBound.y );
+	__m256i by = _mm256_set_epi64x( a2.upperBound.y, b.upperBound.y, a1.upperBound.y, b.upperBound.y );
+	__m256i sy = _mm256_sub_epi64( ay, by );
+
+	__m256i az = _mm256_set_epi64x( b.lowerBound.z, a2.lowerBound.z, b.lowerBound.z, a1.lowerBound.z );
+	__m256i bz = _mm256_set_epi64x( a2.upperBound.z, b.upperBound.z, a1.upperBound.z, b.upperBound.z );
+	__m256i sz = _mm256_sub_epi64( az, bz );
+
+	__m256i zero = _mm256_setzero_si256();
+	__m256i gt = _mm256_or_si256( _mm256_or_si256( _mm256_cmpgt_epi64( sx, zero ), _mm256_cmpgt_epi64( sy, zero ) ),
+								  _mm256_cmpgt_epi64( sz, zero ) );
+
+	// Each separated lane is all-ones (8 bytes), so movemask gives 8 bits per lane:
+	// child1 = lanes 0,1 -> bits 0..15; child2 = lanes 2,3 -> bits 16..31.
+	int mask = _mm256_movemask_epi8( gt );
+
+	int overlap1 = ( mask & 0x0000FFFF ) == 0;
+	int overlap2 = ( mask & 0xFFFF0000 ) == 0;
+
+	return overlap1 | ( overlap2 << 1 );
+}
+#endif
+
 b3TreeStats b3DynamicTree_Query( const b3DynamicTree* tree, b3AABB aabb, uint64_t maskBits, bool requireAllBits,
 								 b3TreeQueryCallbackFcn* callback, void* context )
 {
@@ -1138,8 +1184,25 @@ b3TreeStats b3DynamicTree_Query( const b3DynamicTree* tree, b3AABB aabb, uint64_
 				B3_ASSERT( stackCount < B3_TREE_STACK_SIZE - 1 );
 				if ( stackCount < B3_TREE_STACK_SIZE - 1 )
 				{
-					stack[stackCount++] = node->children.child1;
-					stack[stackCount++] = node->children.child2;
+					int child1 = node->children.child1;
+					int child2 = node->children.child2;
+#if defined( B3_SIMD_AVX512 ) && !defined( BOX3D_LUDICROUS_MODE )
+					// Test both children's fat AABBs in one wide compare. Push only the
+					// overlapping children, in child1-then-child2 order so child2 pops first
+					// and the DFS visit order (and thus the callback sequence) is unchanged.
+					int overlap = b3WideOverlap2( tree->nodes[child1].aabb, tree->nodes[child2].aabb, aabb );
+					if ( overlap & 1 )
+					{
+						stack[stackCount++] = child1;
+					}
+					if ( overlap & 2 )
+					{
+						stack[stackCount++] = child2;
+					}
+#else
+					stack[stackCount++] = child1;
+					stack[stackCount++] = child2;
+#endif
 				}
 			}
 		}
