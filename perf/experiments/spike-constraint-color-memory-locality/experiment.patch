 	return 0;
 }
 
+// Record the exact per-color contact ID stream over a settling ragdoll run.
+// Both the convex and mesh contact arrays contribute in their solve order.
+static uint64_t LayoutMix( uint64_t hash, uint32_t value )
+{
+	hash = ( hash ^ value ) * UINT64_C( 1099511628211 );
+	return hash;
+}
+
+static int ConstraintLayoutBitIdenticalTest( void )
+{
+	static const uint64_t expected[B3_GRAPH_COLOR_COUNT] = {
+		UINT64_C( 0x5c42b6777239f719 ), // color 0
+		UINT64_C( 0xe10e4244728aca29 ), // color 1
+		UINT64_C( 0x6b3570a0a3a4e957 ), // color 2
+		UINT64_C( 0x958bbadaafccfb7e ), // color 3
+		UINT64_C( 0xa4fd8dee060fbd57 ), // color 4
+		UINT64_C( 0x8f8e33f77b295006 ), // color 5
+		UINT64_C( 0xd519f191fa180102 ), // color 6
+		UINT64_C( 0xbe73e5836a513513 ), // color 7
+		UINT64_C( 0x5c42b6777239f719 ), // color 8
+		UINT64_C( 0x5c42b6777239f719 ), // color 9
+		UINT64_C( 0x5c42b6777239f719 ), // color 10
+		UINT64_C( 0x5c42b6777239f719 ), // color 11
+		UINT64_C( 0x5c42b6777239f719 ), // color 12
+		UINT64_C( 0x5c42b6777239f719 ), // color 13
+		UINT64_C( 0x5c42b6777239f719 ), // color 14
+		UINT64_C( 0x5c42b6777239f719 ), // color 15
+		UINT64_C( 0x5c42b6777239f719 ), // color 16
+		UINT64_C( 0x5c42b6777239f719 ), // color 17
+		UINT64_C( 0x5c42b6777239f719 ), // color 18
+		UINT64_C( 0x5c42b6777239f719 ), // color 19
+		UINT64_C( 0x5c42b6777239f719 ), // color 20
+		UINT64_C( 0x02c78a60760093e9 ), // color 21
+		UINT64_C( 0x2b0eb9c8873d78b8 ), // color 22
+		UINT64_C( 0x5c42b6777239f719 ), // color 23
+	}; // captured from unchanged base, one worker
+	for ( int workerCount = 1; workerCount <= 5; ++workerCount )
+	{
+		b3WorldDef worldDef = b3DefaultWorldDef();
+		worldDef.workerCount = workerCount;
+		b3WorldId worldId = b3CreateWorld( &worldDef );
+		b3World* world = b3GetWorldFromId( worldId );
+		RagdollHumanData data = CreateRagdollHuman( worldId );
+		uint64_t order[B3_GRAPH_COLOR_COUNT];
+		for ( int colorIndex = 0; colorIndex < B3_GRAPH_COLOR_COUNT; ++colorIndex )
+		{
+			order[colorIndex] = UINT64_C( 14695981039346656037 );
+		}
+
+		b3Fixed timeStep = b3FixDiv( B3_FIX( 1.0f ), B3_FIX( 60.0f ) );
+		for ( int step = 0; step < 800; ++step )
+		{
+			b3World_Step( worldId, timeStep, 4 );
+			for ( int colorIndex = 0; colorIndex < B3_GRAPH_COLOR_COUNT; ++colorIndex )
+			{
+				b3GraphColor* color = world->constraintGraph.colors + colorIndex;
+				uint64_t hash = LayoutMix( order[colorIndex], (uint32_t)step );
+				hash = LayoutMix( hash, (uint32_t)color->convexContacts.count );
+				for ( int i = 0; i < color->convexContacts.count; ++i )
+				{
+					hash = LayoutMix( hash, (uint32_t)color->convexContacts.data[i] );
+				}
+				hash = LayoutMix( hash, (uint32_t)color->contacts.count );
+				for ( int i = 0; i < color->contacts.count; ++i )
+				{
+					hash = LayoutMix( hash, (uint32_t)color->contacts.data[i].contactId );
+				}
+				order[colorIndex] = hash;
+			}
+			if ( UpdateRagdollHuman( worldId, &data ) )
+			{
+				break;
+			}
+		}
+
+		if ( workerCount == 1 )
+		{
+			for ( int colorIndex = 0; colorIndex < B3_GRAPH_COLOR_COUNT; ++colorIndex )
+			{
+				printf( "  color=%d order=%016" PRIx64 "\n", colorIndex, order[colorIndex] );
+			}
+		}
+		for ( int colorIndex = 0; colorIndex < B3_GRAPH_COLOR_COUNT; ++colorIndex )
+		{
+			ENSURE( order[colorIndex] == expected[colorIndex] );
+		}
+		ENSURE_GOLDEN( data.sleepStep == RAGDOLL_HUMAN_SLEEP_STEP );
+		ENSURE_GOLDEN( data.hash == RAGDOLL_HUMAN_HASH );
+		DestroyRagdollHuman( &data );
+		b3DestroyWorld( worldId );
+	}
+	return 0;
+}
+
 int DeterminismTest( void )
 {
+	RUN_SUBTEST( ConstraintLayoutBitIdenticalTest );
 	RUN_SUBTEST( RagdollHumanTest );
 	RUN_SUBTEST( MultithreadingTest );
 	RUN_SUBTEST( CrossPlatformTest );
