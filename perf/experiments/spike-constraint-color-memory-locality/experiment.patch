+// Wide solver indices are base one, unlike the scalar mesh indices. The
+// next constraint is already prepared and belongs to the same solver block.
+static inline void b3PrefetchWideContact( const b3ContactConstraintWide* next, const b3BodyState* states )
+{
+#if defined( __GNUC__ ) || defined( __clang__ )
+	__builtin_prefetch( next, 0, 1 );
+#endif
+	for ( int lane = 0; lane < B3_SIMD_WIDTH; ++lane )
+	{
+		b3PrefetchBodyState( states, next->indexA[lane] - 1 );
+		b3PrefetchBodyState( states, next->indexB[lane] - 1 );
+	}
+}
