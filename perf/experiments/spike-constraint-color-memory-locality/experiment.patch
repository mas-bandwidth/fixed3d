+# The determinism suite includes ConstraintLayoutBitIdenticalTest, which pins
+# the per-color contact ID stream and ragdoll result at worker counts 1..5.
+add_test(NAME ConstraintLayoutBitIdenticalTest COMMAND $<TARGET_FILE:box3d_test> DeterminismTest)
+
 file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/CTestTestfile.cmake" CONTENT "subdirs(\"test\")\n")
