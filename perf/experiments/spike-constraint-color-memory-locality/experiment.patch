+// A read-only hint for the next contact's scattered awake-body state. Solver
+// indices are stable from prepare through the color barriers; zero/NULL bodies
+// are represented by the identity state and have nothing to prefetch.
+static inline void b3PrefetchBodyState( const b3BodyState* states, int zeroBasedIndex )
+{
+#if defined( __GNUC__ ) || defined( __clang__ )
+	if ( zeroBasedIndex >= 0 )
+	{
+		const b3BodyState* state = states + zeroBasedIndex;
+		__builtin_prefetch( state, 0, 1 );
+		__builtin_prefetch( &state->deltaPosition, 0, 1 );
+	}
+#else
+	(void)states;
+	(void)zeroBasedIndex;
+#endif
+}
+
+static inline void b3PrefetchMeshContact( const b3ContactConstraint* next, const b3BodyState* states )
+{
+#if defined( __GNUC__ ) || defined( __clang__ )
+	__builtin_prefetch( next, 0, 1 );
+	if ( next->manifoldCount > 0 )
+	{
+		__builtin_prefetch( next->constraints, 0, 1 );
+	}
+#endif
+	b3PrefetchBodyState( states, next->indexA );
+	b3PrefetchBodyState( states, next->indexB );
+}
+
 // contact separation for sub-stepping
 // s = s0 + dot(cB + rB - cA - rA, normal)
 // normal is held constant
