+// Differential proof for the 256/128 middle arm of b3Solve3AcrossScales. Integer division
+// is unique, so the middle arm must agree with the full 256-bit Knuth path for every input;
+// this test compares the two directly rather than trusting either.
+static uint64_t MiddleArmRngNext( uint64_t* s )
+{
+	uint64_t x = *s;
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	*s = x;
+	return x;
+}
+
+// The pre-middle-arm solve: every component divides through the four-limb fixUInt256DivMod.
+// Kept verbatim so the differential is against the historical wide path, not a paraphrase.
+static b3Vec3 Solve3AcrossScalesFullPath( b3Matrix3 m, b3Vec3 a )
+{
+	if ( a.x == 0 && a.y == 0 && a.z == 0 )
+	{
+		return b3Vec3_zero;
+	}
+
+	fixInt128 c00 = fixCofactor128( m.cy.y, m.cz.z, m.cy.z, m.cz.y );
+	fixInt128 c01 = fixCofactor128( m.cy.z, m.cz.x, m.cy.x, m.cz.z );
+	fixInt128 c02 = fixCofactor128( m.cy.x, m.cz.y, m.cy.y, m.cz.x );
+	fixInt128 c10 = fixCofactor128( m.cz.y, m.cx.z, m.cz.z, m.cx.y );
+	fixInt128 c11 = fixCofactor128( m.cz.z, m.cx.x, m.cz.x, m.cx.z );
+	fixInt128 c12 = fixCofactor128( m.cz.x, m.cx.y, m.cz.y, m.cx.x );
+	fixInt128 c20 = fixCofactor128( m.cx.y, m.cy.z, m.cx.z, m.cy.y );
+	fixInt128 c21 = fixCofactor128( m.cx.z, m.cy.x, m.cx.x, m.cy.z );
+	fixInt128 c22 = fixCofactor128( m.cx.x, m.cy.y, m.cx.y, m.cy.x );
+
+	fixUInt256 det = fixUInt256Add( fixUInt256Add( fixInt256MulI128ByI64( c00, m.cx.x ), fixInt256MulI128ByI64( c10, m.cy.x ) ),
+									fixInt256MulI128ByI64( c20, m.cz.x ) );
+	if ( fixUInt256IsZero( det ) )
+	{
+		return b3Vec3_zero;
+	}
+
+	bool negative = fixInt256IsNegative( det );
+	fixUInt256 absDet = fixInt256Abs( det );
+
+	fixUInt256 nx = fixUInt256Add( fixUInt256Add( fixInt256MulI128ByI64( c00, a.x ), fixInt256MulI128ByI64( c01, a.y ) ),
+								   fixInt256MulI128ByI64( c02, a.z ) );
+	fixUInt256 ny = fixUInt256Add( fixUInt256Add( fixInt256MulI128ByI64( c10, a.x ), fixInt256MulI128ByI64( c11, a.y ) ),
+								   fixInt256MulI128ByI64( c12, a.z ) );
+	fixUInt256 nz = fixUInt256Add( fixUInt256Add( fixInt256MulI128ByI64( c20, a.x ), fixInt256MulI128ByI64( c21, a.y ) ),
+								   fixInt256MulI128ByI64( c22, a.z ) );
+
+	b3Vec3 out = {
+		fixDivShifted256( nx, B3_INVERSE_FRACTION_BITS, absDet, negative ),
+		fixDivShifted256( ny, B3_INVERSE_FRACTION_BITS, absDet, negative ),
+		fixDivShifted256( nz, B3_INVERSE_FRACTION_BITS, absDet, negative ),
+	};
+	return out;
+}
+
+// A seeded entry whose magnitude spans roughly 2^lo .. 2^hi: the raw word is masked to
+// `hi` bits and signed, so the sweep covers every scale in the arm's range.
+static b3Fixed MiddleArmEntry( uint64_t* s, int lo, int hi )
+{
+	uint64_t r = MiddleArmRngNext( s );
+	int shift = lo + (int)( MiddleArmRngNext( s ) % (uint64_t)( hi - lo + 1 ) );
+	int64_t v = (int64_t)( r >> shift );
+	return ( MiddleArmRngNext( s ) & 1 ) ? -v : v;
+}
+
+static int Solve3AcrossScalesMiddleArmTest( void )
+{
+	uint64_t state = 0x9E3779B97F4A7C15ULL;
+
+	// 10 million seeded matrices across scales 2^-10 .. 2^40 (entry magnitude), comparing
+	// the middle-arm solve against the full 256-bit path.
+	for ( int i = 0; i < 10000000; ++i )
+	{
+		b3Matrix3 m = {
+			{ MiddleArmEntry( &state, -10, 40 ), MiddleArmEntry( &state, -10, 40 ), MiddleArmEntry( &state, -10, 40 ) },
+			{ MiddleArmEntry( &state, -10, 40 ), MiddleArmEntry( &state, -10, 40 ), MiddleArmEntry( &state, -10, 40 ) },
+			{ MiddleArmEntry( &state, -10, 40 ), MiddleArmEntry( &state, -10, 40 ), MiddleArmEntry( &state, -10, 40 ) },
+		};
+		b3Vec3 a = { MiddleArmEntry( &state, -10, 24 ), MiddleArmEntry( &state, -10, 24 ), MiddleArmEntry( &state, -10, 24 ) };
+
+		b3Vec3 actual = b3Solve3AcrossScales( m, a );
+		b3Vec3 expected = Solve3AcrossScalesFullPath( m, a );
+		if ( actual.x != expected.x || actual.y != expected.y || actual.z != expected.z )
+		{
+			printf( "  middle-arm divergence at i=%d: actual=(%g,%g,%g) expected=(%g,%g,%g)\n", i,
+					b3FixToDouble( actual.x ), b3FixToDouble( actual.y ), b3FixToDouble( actual.z ),
+					b3FixToDouble( expected.x ), b3FixToDouble( expected.y ), b3FixToDouble( expected.z ) );
+			return 1;
+		}
+	}
+
+	// Determinant exactly at the arm gate: 2^64 - 1 (single-limb divisor), 2^64 (two-limb,
+	// normalization shift 63), and 2^127 (two-limb, no normalization). Compare the helper
+	// against the wide path directly on random numerators.
+	{
+		const uint64_t detLo[3] = { UINT64_MAX, 0, 0 };
+		const uint64_t detHi[3] = { 0, 1, 1ULL << 63 };
+		for ( int g = 0; g < 3; ++g )
+		{
+			fixUInt128 absDet = fixUInt128Make( detHi[g], detLo[g] );
+			for ( int i = 0; i < 100000; ++i )
+			{
+				uint64_t l0 = MiddleArmRngNext( &state ), l1 = MiddleArmRngNext( &state );
+				uint64_t h0 = MiddleArmRngNext( &state ), h1 = MiddleArmRngNext( &state );
+				fixUInt256 numerator = { fixUInt128Make( h1, h0 ), fixUInt128Make( l1, l0 ) };
+
+				b3Fixed actual = b3DivShifted256By128( numerator, B3_INVERSE_FRACTION_BITS, absDet, false );
+				b3Fixed expected = fixDivShifted256( numerator, B3_INVERSE_FRACTION_BITS, fixUInt256FromU128( absDet ), false );
+				if ( actual != expected )
+				{
+					printf( "  arm-gate divergence at gate=%d i=%d\n", g, i );
+					return 1;
+				}
+			}
+		}
+	}
+
+	// Asteroid regression: inverse values retain their low quanta through the middle arm.
+	b3Matrix3 small = { { 6, 0, 0 }, { 0, 70369, 0 }, { 0, 0, 6 } };
+	b3Vec3 x = b3Solve3AcrossScales( small, (b3Vec3){ 1, -1, 2 } );
+	if ( x.x != ( (int64_t)1 << 40 ) / 6 || x.y != -( ( (int64_t)1 << 40 ) / 70369 ) || x.z != ( (int64_t)2 << 40 ) / 6 )
+	{
+		return 1;
+	}
+
+	// Tiny-body regression: cofactors at 2^107 keep the full 256-bit path; the gate must
+	// route them wide and the solve must match the wide answer exactly.
+	for ( int e = 41; e <= 60; ++e )
+	{
+		b3Fixed s = (b3Fixed)1 << e;
+		b3Matrix3 diag = { { s, 0, 0 }, { 0, s, 0 }, { 0, 0, s } };
+		b3Vec3 a = { (b3Fixed)1 << 20, -( (b3Fixed)1 << 20 ), (b3Fixed)1 << 19 };
+		b3Vec3 actual = b3Solve3AcrossScales( diag, a );
+		b3Vec3 expected = Solve3AcrossScalesFullPath( diag, a );
+		if ( actual.x != expected.x || actual.y != expected.y || actual.z != expected.z )
+		{
+			printf( "  tiny-body divergence at e=%d\n", e );
+			return 1;
+		}
+	}
+
+	return 0;
+}
