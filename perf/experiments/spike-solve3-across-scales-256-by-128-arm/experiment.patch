+/// Dedicated 256-by-128 unsigned division for the middle arm of b3Solve3AcrossScales.
+///
+/// The general fixUInt256DivMod is a four-limb Knuth Algorithm D; an ordinary joint's
+/// per-mass determinant is near 2^120 and fits in 128 bits, so its divisor is at most two
+/// limbs and the four-limb machinery (limb scan, full normalization, general loop) is
+/// wasted work. This is the 256-bit analogue of fixInt128Div's x86 128/64 divq fast tier:
+/// the divisor is known up front to fit in 128 bits, so the Knuth loop is specialized to a
+/// one- or two-limb divisor and the inner step is the hardware 128/64 divide.
+///
+/// EXACT by construction: integer division is unique, so the quotient and remainder equal
+/// fixUInt256DivMod's for every input whose divisor fits in 128 bits. The structure mirrors
+/// fixUInt256DivMod's short-division (n == 1) and two-limb (n == 2) bodies, including the
+/// rare add-back arm, so the two cannot drift apart.
+///
+/// The divisor is asserted non-zero by the caller (the determinant zero test above), and
+/// this path is only entered when the determinant's high limb is zero.
+B3_INLINE void b3UInt256DivMod128( fixUInt256 dividend, fixUInt128 divisor, fixUInt256* quotientOut, fixUInt256* remainderOut )
+{
+	uint64_t u[4];
+	fixUInt256ToLimbs( dividend, u );
+
+	uint64_t v[2] = { fixUInt128Lo( divisor ), fixUInt128Hi( divisor ) };
+	uint64_t q[4] = { 0, 0, 0, 0 };
+
+	int n = ( v[1] == 0 ) ? 1 : 2;
+	if ( n == 1 && v[0] == 0 )
+	{
+		fixUInt256 zero = { FIX_UINT128_ZERO, FIX_UINT128_ZERO };
+		*quotientOut = zero;
+		*remainderOut = zero;
+		return;
+	}
+
+	int m = 4;
+	while ( m > 0 && u[m - 1] == 0 ) { m--; }
+
+	if ( m < n )
+	{
+		fixUInt256 zero = { FIX_UINT128_ZERO, FIX_UINT128_ZERO };
+		*quotientOut = zero;
+		*remainderOut = dividend;
+		return;
+	}
+
+	if ( n == 1 )
+	{
+		uint64_t rest = 0;
+		for ( int i = m - 1; i >= 0; i-- )
+		{
+			q[i] = fixUInt128DivRemBy64( fixUInt128Make( rest, u[i] ), v[0], &rest );
+		}
+		*quotientOut = fixUInt256FromLimbs( q );
+		*remainderOut = fixUInt256FromU64( rest );
+		return;
+	}
+
+	int s = fixCountLeadingZeros64( v[1] );
+	uint64_t vn[2];
+	vn[1] = fixShiftInLimb( v[1], v[0], s );
+	vn[0] = v[0] << s;
+
+	uint64_t un[5];
+	un[m] = s == 0 ? 0 : ( u[m - 1] >> ( 64 - s ) );
+	for ( int i = m - 1; i > 0; i-- ) { un[i] = fixShiftInLimb( u[i], u[i - 1], s ); }
+	un[0] = u[0] << s;
+
+	for ( int j = m - n; j >= 0; j-- )
+	{
+		uint64_t qhat;
+		uint64_t rhat;
+		bool rhatFits;
+
+		if ( un[j + n] >= vn[n - 1] )
+		{
+			qhat = UINT64_MAX;
+			fixUInt128 numerator = fixUInt128Make( un[j + n], un[j + n - 1] );
+			fixUInt128 product = fixUInt128MulU64( qhat, vn[n - 1] );
+			fixUInt128 rest = fixUInt128Sub( numerator, product );
+			rhatFits = fixUInt128Hi( rest ) == 0;
+			rhat = fixUInt128Lo( rest );
+		}
+		else
+		{
+			qhat = fixUInt128DivRemBy64( fixUInt128Make( un[j + n], un[j + n - 1] ), vn[n - 1], &rhat );
+			rhatFits = true;
+		}
+
+		while ( rhatFits && qhat != 0 &&
+				fixUInt128Gt( fixUInt128MulU64( qhat, vn[n - 2] ), fixUInt128Make( rhat, un[j + n - 2] ) ) )
+		{
+			qhat--;
+			fixUInt128 widened = fixUInt128Add( fixUInt128FromU64( rhat ), fixUInt128FromU64( vn[n - 1] ) );
+			rhatFits = fixUInt128Hi( widened ) == 0;
+			rhat = fixUInt128Lo( widened );
+		}
+
+		uint64_t borrow = 0;
+		uint64_t carry = 0;
+		for ( int i = 0; i < n; i++ )
+		{
+			fixUInt128 product = fixUInt128Add( fixUInt128MulU64( qhat, vn[i] ), fixUInt128FromU64( carry ) );
+			carry = fixUInt128Hi( product );
+
+			fixUInt128 left = fixUInt128FromU64( un[i + j] );
+			fixUInt128 right = fixUInt128Add( fixUInt128FromU64( fixUInt128Lo( product ) ), fixUInt128FromU64( borrow ) );
+			if ( fixUInt128Ge( left, right ) )
+			{
+				un[i + j] = fixUInt128Lo( fixUInt128Sub( left, right ) );
+				borrow = 0;
+			}
+			else
+			{
+				un[i + j] = fixUInt128Lo( fixUInt128Sub( fixUInt128Add( left, fixUInt128Shl( fixUInt128FromU64( 1 ), 64 ) ), right ) );
+				borrow = 1;
+			}
+		}
+
+		bool negative;
+		{
+			fixUInt128 left = fixUInt128FromU64( un[j + n] );
+			fixUInt128 right = fixUInt128Add( fixUInt128FromU64( carry ), fixUInt128FromU64( borrow ) );
+			if ( fixUInt128Ge( left, right ) )
+			{
+				un[j + n] = fixUInt128Lo( fixUInt128Sub( left, right ) );
+				negative = false;
+			}
+			else
+			{
+				un[j + n] = fixUInt128Lo( fixUInt128Sub( fixUInt128Add( left, fixUInt128Shl( fixUInt128FromU64( 1 ), 64 ) ), right ) );
+				negative = true;
+			}
+		}
+
+		q[j] = qhat;
+
+		if ( negative )
+		{
+			q[j] = qhat - 1;
+			uint64_t addCarry = 0;
+			for ( int i = 0; i < n; i++ )
+			{
+				fixUInt128 sum = fixUInt128Add( fixUInt128Add( fixUInt128FromU64( un[i + j] ), fixUInt128FromU64( vn[i] ) ),
+												fixUInt128FromU64( addCarry ) );
+				un[i + j] = fixUInt128Lo( sum );
+				addCarry = fixUInt128Hi( sum );
+			}
+			un[j + n] += addCarry;
+		}
+	}
+
+	uint64_t r[4] = { 0, 0, 0, 0 };
+	for ( int i = 0; i < n - 1; i++ ) { r[i] = ( un[i] >> s ) | ( s == 0 ? 0 : ( un[i + 1] << ( 64 - s ) ) ); }
+	r[n - 1] = un[n - 1] >> s;
+
+	*quotientOut = fixUInt256FromLimbs( q );
+	*remainderOut = fixUInt256FromLimbs( r );
+}
+
+/// The shifted 256/128 ratio that mirrors fixDivShifted256 for the middle arm: the exact
+/// ( cofactor << shift ) / determinant, truncated to Q48.16 and saturating outside range,
+/// when the determinant's high limb is zero (fits in 128 bits). Same rounding and
+/// saturation as the wide path, so the two agree exactly wherever both are defined.
+B3_INLINE b3Fixed b3DivShifted256By128( fixUInt256 numerator, int shift, fixUInt128 absDet, bool determinantNegative )
+{
+	bool numeratorNegative = fixInt256IsNegative( numerator );
+	fixUInt256 scaled = fixUInt256Shl( fixInt256Abs( numerator ), shift );
+
+	fixUInt256 quotient;
+	fixUInt256 remainder;
+	b3UInt256DivMod128( scaled, absDet, &quotient, &remainder );
+
+	bool negative = numeratorNegative != determinantNegative;
+
+	bool representable = fixUInt128Eq( quotient.hi, FIX_UINT128_ZERO ) &&
+						 fixUInt128Le( quotient.lo, fixUInt128FromU64( (uint64_t)B3_FIXED_MAX ) );
+	if ( representable == false )
+	{
+		return negative ? -B3_FIXED_MAX : B3_FIXED_MAX;
+	}
+
+	int64_t magnitude = (int64_t)fixUInt128Lo( quotient.lo );
+	return negative ? -magnitude : magnitude;
+}
