+static int HullBlobSoaMatchesAosTest( void )
+{
+	// A hull whose local AABB fits int32: the cube corners are +-1, well within
+	// int32 raw Q48.16, so the SoA bake is lossless.
+	b3HullData* hull = b3CreateHull( s_cubeCorners, 8, 8 );
+	ENSURE( hull != NULL );
+	ENSURE( hull->soaOffset != 0 );
+
+	int vertexCount = hull->vertexCount;
+	int paddedCount = ( vertexCount + 3 ) & ~3;
+	const b3Vec3* points = b3GetHullPoints( hull );
+	const int32_t* vx = (const int32_t*)( (intptr_t)hull + hull->soaOffset );
+	const int32_t* vy = vx + paddedCount;
+	const int32_t* vz = vy + paddedCount;
+
+	for ( int i = 0; i < vertexCount; ++i )
+	{
+		ENSURE( vx[i] == (int32_t)points[i].x );
+		ENSURE( vy[i] == (int32_t)points[i].y );
+		ENSURE( vz[i] == (int32_t)points[i].z );
+	}
+	for ( int i = vertexCount; i < paddedCount; ++i )
+	{
+		ENSURE( vx[i] == 0 && vy[i] == 0 && vz[i] == 0 );
+	}
+
+	// Two builds of the same hull hash equal (the SoA bytes are hashed raw).
+	b3HullData* hull2 = b3CreateHull( s_cubeCorners, 8, 8 );
+	ENSURE( hull2 != NULL );
+	ENSURE( hull->hash == hull2->hash );
+	b3DestroyHull( hull2 );
+	b3DestroyHull( hull );
+
+	// A hull whose AABB exceeds int32 bakes nothing. The quickhull builder
+	// hangs on large coordinates (pre-existing), so push the local AABB past
+	// int32 with a clone-and-transform translation instead.
+	b3HullData* base = b3CreateHull( s_cubeCorners, 8, 8 );
+	ENSURE( base != NULL );
+	b3Transform bigXf = { .p = { B3_FIX( 40000.0f ), B3_FIX( 0.0f ), B3_FIX( 0.0f ) }, .q = b3Quat_identity };
+	b3Vec3 one = { B3_FIX( 1.0f ), B3_FIX( 1.0f ), B3_FIX( 1.0f ) };
+	b3HullData* bigHull = b3CloneAndTransformHull( base, bigXf, one );
+	ENSURE( bigHull != NULL );
+	ENSURE( bigHull->soaOffset == 0 );
+	b3DestroyHull( bigHull );
+	b3DestroyHull( base );
+
+	return 0;
+}
