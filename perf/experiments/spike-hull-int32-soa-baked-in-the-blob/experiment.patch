+// True when every final vertex position fits in int32 raw Q48.16, i.e. the
+// hull's local AABB fits int32 and the SoA bake is lossless.
+static bool b3HullPointsFitInt32( const b3QHVertex* const* tempVertices, int vertexCount )
+{
+	for ( int i = 0; i < vertexCount; ++i )
+	{
+		b3Vec3 p = tempVertices[i]->position;
+		if ( p.x < INT32_MIN || p.x > INT32_MAX || p.y < INT32_MIN || p.y > INT32_MAX || p.z < INT32_MIN || p.z > INT32_MAX )
+		{
+			return false;
+		}
+	}
+	return true;
+}
