+// Argmax of dot(direction, points[i]) over the baked int32 SoA vertex arrays.
+// The SoA is only baked when the hull's local AABB fits int32, so each int32
+// lane is the exact raw Q48.16 value (lossless truncation) and the widened
+// int64 products are bit-identical to the AoS gather path. Straight loads
+// replace the permutex2var gather of the AoS variant.
+static int b3FindSupportVertexSoaWide( const int32_t* vx, const int32_t* vy, const int32_t* vz, int count, b3Vec3 direction )
+{
+	__m256i dirX = _mm256_set1_epi64x( direction.x );
+	__m256i dirY = _mm256_set1_epi64x( direction.y );
+	__m256i dirZ = _mm256_set1_epi64x( direction.z );
+
+	__m256i bestVal = _mm256_setzero_si256();
+	__m256i bestIdx = _mm256_setzero_si256();
+	__m256i curIdx = _mm256_setr_epi64x( 0, 1, 2, 3 );
+	const __m256i four = _mm256_set1_epi64x( 4 );
+
+	int groupCount = count / 4;
+	for ( int group = 0; group < groupCount; ++group )
+	{
+		__m256i px = _mm256_cvtepi32_epi64( _mm_loadu_si128( (const __m128i*)( vx + 4 * group ) ) );
+		__m256i py = _mm256_cvtepi32_epi64( _mm_loadu_si128( (const __m128i*)( vy + 4 * group ) ) );
+		__m256i pz = _mm256_cvtepi32_epi64( _mm_loadu_si128( (const __m128i*)( vz + 4 * group ) ) );
+
+		__m256i dot = _mm256_add_epi64( _mm256_add_epi64( _mm256_mullo_epi64( dirX, px ), _mm256_mullo_epi64( dirY, py ) ),
+										_mm256_mullo_epi64( dirZ, pz ) );
+
+		if ( group == 0 )
+		{
+			bestVal = dot;
+			bestIdx = curIdx;
+		}
+		else
+		{
+			__mmask8 greater = _mm256_cmpgt_epi64_mask( dot, bestVal );
+			bestVal = _mm256_mask_blend_epi64( greater, bestVal, dot );
+			bestIdx = _mm256_mask_blend_epi64( greater, bestIdx, curIdx );
+		}
+		curIdx = _mm256_add_epi64( curIdx, four );
+	}
+
+	int64_t vals[4], idxs[4];
+	_mm256_storeu_si256( (__m256i*)vals, bestVal );
+	_mm256_storeu_si256( (__m256i*)idxs, bestIdx );
+	int bestIndex = (int)idxs[0];
+	b3Int128 bestDot = vals[0];
+	for ( int lane = 1; lane < 4; ++lane )
+	{
+		if ( vals[lane] > bestDot || ( vals[lane] == bestDot && idxs[lane] < bestIndex ) )
+		{
+			bestDot = vals[lane];
+			bestIndex = (int)idxs[lane];
+		}
+	}
+
+	// Tail on the exact 128-bit compare; the int32 lanes are lossless, so
+	// reconstructing the point from the SoA equals the AoS value.
+	for ( int index = 4 * groupCount; index < count; ++index )
+	{
+		b3Vec3 p = { vx[index], vy[index], vz[index] };
+		b3Int128 dot = b3DotRaw( direction, p );
+		if ( dot > bestDot )
+		{
+			bestDot = dot;
+			bestIndex = index;
+		}
+	}
+
+	return bestIndex;
+}
