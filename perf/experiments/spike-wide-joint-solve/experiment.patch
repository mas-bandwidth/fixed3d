diff --git a/test/test_joint.c b/test/test_joint.c
index 6187b9c..4bbe641 100644
--- a/test/test_joint.c
+++ b/test/test_joint.c
@@ -6,6 +6,14 @@
 #include "box3d/box3d.h"
 #include "box3d/math_functions.h"
 
+#include "body.h"
+#include "joint.h"
+#include "solver.h"
+#include "solver_set.h"
+#include "physics_world.h"
+
+#include <string.h>
+
 // One sub-test per joint type. Each creates the joint, exercises the shared
 // b3Joint_* API plus every type-specific accessor, then steps to make sure the
 // joint solves without tripping a validation assert.
@@ -779,8 +787,185 @@ static int TestNonDynamicJointDisable( void )
 	return 0;
 }
 
+// Wide spherical joint equivalence: the wide solver (four joints per wide
+// constraint, lane = whole joint) must be bit-identical to the scalar solver.
+// Builds a world with four spherical joints on disjoint bodies, steps once to
+// prepare, then runs the scalar and wide warm-start/solve on identical
+// snapshots and compares every impulse and body delta byte for byte. Joints
+// cover soft constraints, cone/twist limits, motors, and an asteroid-scale
+// mass regression (a body whose inverse mass is the smallest representable).
+static int TestWideSphericalJointEquivalence( void )
+{
+	b3WorldDef worldDef = b3DefaultWorldDef();
+	worldDef.gravity = b3Vec3_zero;
+	b3WorldId worldId = b3CreateWorld( &worldDef );
+
+	// Eight disjoint dynamic bodies, two per joint.
+	b3BodyId bodyIds[8];
+	for ( int i = 0; i < 8; ++i )
+	{
+		b3BodyDef bodyDef = b3DefaultBodyDef();
+		bodyDef.type = b3_dynamicBody;
+		bodyDef.position = (b3Pos){ b3FixFromInt( i * 3 ), B3_FIX( 4.0f ), B3_FIX( 0.0f ) };
+		bodyIds[i] = b3CreateBody( worldId, &bodyDef );
+
+		b3ShapeDef shapeDef = b3DefaultShapeDef();
+		shapeDef.density = B3_FIX( 1.0f );
+		b3BoxHull box = b3MakeCubeHull( B3_FIX( 0.5f ) );
+		b3CreateHullShape( bodyIds[i], &shapeDef, &box.base );
+	}
+
+	// Asteroid-scale mass regression: the largest mass whose inverse mass is
+	// representable (65536 units), so invMass is one raw ulp.
+	b3MassData massData = { b3FixFromInt( 65536 ), b3Vec3_zero, b3Mat3_zero };
+	b3Body_SetMassData( bodyIds[6], massData );
+
+	// Four spherical joints with varied features.
+	b3JointId jointIds[4];
+	for ( int j = 0; j < 4; ++j )
+	{
+		b3SphericalJointDef def = b3DefaultSphericalJointDef();
+		def.base.bodyIdA = bodyIds[2 * j];
+		def.base.bodyIdB = bodyIds[2 * j + 1];
+		def.base.localFrameA.p = (b3Vec3){ B3_FIX( 0.0f ), B3_FIX( 0.0f ), B3_FIX( 0.0f ) };
+		def.base.localFrameB.p = (b3Vec3){ B3_FIX( 0.0f ), B3_FIX( 0.0f ), B3_FIX( 0.0f ) };
+		def.hertz = B3_FIX( 5.0f );
+		def.dampingRatio = B3_FIX( 0.5f );
+		def.enableSpring = ( j & 1 ) != 0;
+		def.enableMotor = ( j & 2 ) != 0;
+		def.enableConeLimit = ( j & 1 ) != 0;
+		def.enableTwistLimit = ( j & 2 ) != 0;
+		def.coneAngle = B3_FIX( 0.5f );
+		def.lowerTwistAngle = -B3_FIX( 0.5f );
+		def.upperTwistAngle = B3_FIX( 0.5f );
+		def.motorVelocity = (b3Vec3){ B3_FIX( 0.1f ), B3_FIX( 0.2f ), B3_FIX( 0.3f ) };
+		def.maxMotorTorque = B3_FIX( 50.0f );
+		jointIds[j] = b3CreateSphericalJoint( worldId, &def );
+	}
+
+	// Give the bodies some velocity so the solve has nonzero error to correct.
+	for ( int i = 0; i < 8; ++i )
+	{
+		b3Body_SetLinearVelocity( bodyIds[i], (b3Vec3){ B3_FIX( 0.5f ), -B3_FIX( 0.25f ), B3_FIX( 0.1f ) } );
+		b3Body_SetAngularVelocity( bodyIds[i], (b3Vec3){ B3_FIX( 0.2f ), B3_FIX( 0.1f ), -B3_FIX( 0.3f ) } );
+	}
+
+	// Step once to prepare the joints and populate the graph.
+	b3Fixed timeStep = b3FixDiv( B3_FIX( 1.0f ), B3_FIX( 60.0f ) );
+	b3World_Step( worldId, timeStep, 4 );
+
+	b3World* world = b3GetWorld( worldId.index1 - 1 );
+
+	// Gather the four joint sims and their body states.
+	b3JointSim* joints[4];
+	for ( int j = 0; j < 4; ++j )
+	{
+		b3Joint* joint = b3GetJointFullId( world, jointIds[j] );
+		joints[j] = b3GetJointSim( world, joint );
+	}
+
+	b3SolverSet* awakeSet = b3Array_Get( world->solverSets, b3_awakeSet );
+	b3BodyState* states = awakeSet->bodyStates.data;
+
+	int stateCount = awakeSet->bodyStates.count;
+	ENSURE( stateCount >= 8 && stateCount <= 16 );
+
+	// 10,000 seeded quadruples. Each seed randomizes the body velocities and
+	// delta positions, the accumulated (warm-start) impulses, the feature flags
+	// and useBias, then runs the scalar functions joint by joint on one copy and
+	// the wide entry points on another, and compares impulses and every body
+	// state byte for byte. Seeds are a fixed xorshift: no clock, no rand().
+	b3JointSim scalarJoints[4], wideJoints[4], baseJoints[4];
+	b3BodyState scalarStates[16], wideStates[16];
+	memset( scalarJoints, 0, sizeof( scalarJoints ) );
+	memset( scalarStates, 0, sizeof( scalarStates ) );
+	for ( int j = 0; j < 4; ++j )
+	{
+		baseJoints[j] = *joints[j];
+	}
+
+	uint64_t rng = 0x9E3779B97F4A7C15ull;
+#define WIDE_NEXT() ( rng ^= rng << 13, rng ^= rng >> 7, rng ^= rng << 17, rng )
+	// A raw value in [-range, range] (range in raw Q48.16 units).
+#define WIDE_RAND( range ) ( (b3Fixed)( WIDE_NEXT() % ( 2 * (uint64_t)( range ) + 1 ) ) - (b3Fixed)( range ) )
+
+	b3StepContext context = { 0 };
+	context.h = b3FixDiv( timeStep, b3FixFromInt( 4 ) );
+	context.inv_h = b3FixDiv( B3_FIX( 1.0f ), context.h );
+	context.positionGeneration = 1;
+	context.enableWarmStarting = true;
+
+	const b3Fixed velRange = B3_FIX( 20.0f );
+	const b3Fixed posRange = B3_FIX( 0.25f );
+	const b3Fixed impRange = B3_FIX( 5.0f );
+
+	for ( int seed = 0; seed < 10000; ++seed )
+	{
+		for ( int k = 0; k < stateCount; ++k )
+		{
+			b3BodyState st = states[k];
+			st.linearVelocity = (b3Vec3){ WIDE_RAND( velRange ), WIDE_RAND( velRange ), WIDE_RAND( velRange ) };
+			st.angularVelocity = (b3Vec3){ WIDE_RAND( velRange ), WIDE_RAND( velRange ), WIDE_RAND( velRange ) };
+			st.deltaPosition = (b3Vec3){ WIDE_RAND( posRange ), WIDE_RAND( posRange ), WIDE_RAND( posRange ) };
+			scalarStates[k] = st;
+		}
+		// Copy bytes, padding included, so the byte compare below sees only
+		// what the solvers wrote.
+		memcpy( wideStates, scalarStates, (size_t)stateCount * sizeof( b3BodyState ) );
+
+		for ( int j = 0; j < 4; ++j )
+		{
+			b3JointSim js = baseJoints[j];
+			b3SphericalJoint* sj = &js.sphericalJoint;
+			uint64_t flags = WIDE_NEXT();
+			sj->enableSpring = ( flags & 1 ) != 0;
+			sj->enableMotor = ( flags & 2 ) != 0;
+			sj->enableConeLimit = ( flags & 4 ) != 0;
+			sj->enableTwistLimit = ( flags & 8 ) != 0;
+			sj->linearImpulse = (b3Vec3){ WIDE_RAND( impRange ), WIDE_RAND( impRange ), WIDE_RAND( impRange ) };
+			sj->springImpulse = (b3Vec3){ WIDE_RAND( impRange ), WIDE_RAND( impRange ), WIDE_RAND( impRange ) };
+			sj->motorImpulse = (b3Vec3){ WIDE_RAND( impRange ), WIDE_RAND( impRange ), WIDE_RAND( impRange ) };
+			sj->lowerTwistImpulse = (b3Fixed)( WIDE_NEXT() % ( (uint64_t)impRange + 1 ) );
+			sj->upperTwistImpulse = (b3Fixed)( WIDE_NEXT() % ( (uint64_t)impRange + 1 ) );
+			sj->swingImpulse = (b3Fixed)( WIDE_NEXT() % ( (uint64_t)impRange + 1 ) );
+			// generation 0 forces the anchor cache to refresh from the random state
+			sj->geometryGeneration = 0;
+			scalarJoints[j] = js;
+		}
+		memcpy( wideJoints, scalarJoints, sizeof( scalarJoints ) );
+
+		bool useBias = ( WIDE_NEXT() & 1 ) != 0;
+
+		context.states = scalarStates;
+		for ( int j = 0; j < 4; ++j )
+		{
+			b3WarmStartSphericalJoint( scalarJoints + j, &context );
+		}
+		for ( int j = 0; j < 4; ++j )
+		{
+			b3SolveSphericalJoint( scalarJoints + j, &context, useBias );
+		}
+
+		context.states = wideStates;
+		b3WarmStartSphericalJointWide( wideJoints, &context );
+		b3SolveSphericalJointWide( wideJoints, &context, useBias );
+
+		for ( int j = 0; j < 4; ++j )
+		{
+			ENSURE( memcmp( &scalarJoints[j], &wideJoints[j], sizeof( b3JointSim ) ) == 0 );
+		}
+		ENSURE( memcmp( scalarStates, wideStates, (size_t)stateCount * sizeof( b3BodyState ) ) == 0 );
+	}
+#undef WIDE_RAND
+#undef WIDE_NEXT
+
+	b3DestroyWorld( worldId );
+	return 0;
+}
+
 int JointTest( void )
 {
+	RUN_SUBTEST( TestWideSphericalJointEquivalence );
 	RUN_SUBTEST( TestCreateJointClearsContacts );
 	RUN_SUBTEST( TestJointInverseScaleCorrection );
 	RUN_SUBTEST( TestParallelJoint );
