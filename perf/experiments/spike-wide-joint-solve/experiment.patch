 }
 
+// Wide spherical joint solver: four contiguous spherical joints solved as one
+// wide constraint (lane = whole joint). The tracer-bullet first cut keeps the
+// per-lane math scalar (a plain four-way loop) so every lane is bit-identical
+// to the scalar functions by construction; the AVX-512 lane vectorization is
+// the follow-on work this spike is sized to measure. The scalar path stays as
+// the control and the wide path is selected at compile time (BOX3D_AVX512).
+void b3WarmStartSphericalJointWide( b3JointSim* joints, b3StepContext* context )
+{
+	for ( int i = 0; i < 4; ++i )
+	{
+		b3WarmStartSphericalJoint( joints + i, context );
+	}
+}
+
+void b3SolveSphericalJointWide( b3JointSim* joints, b3StepContext* context, bool useBias )
+{
+	for ( int i = 0; i < 4; ++i )
+	{
+		b3SolveSphericalJoint( joints + i, context, useBias );
+	}
+}
