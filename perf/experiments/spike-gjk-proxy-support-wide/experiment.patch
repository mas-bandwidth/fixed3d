+// The hull support gate is based on exact int64 products. Here the operands
+// are point-minus-origin differences, because GJK compares rounded b3Dot of
+// those differences rather than raw dot products of the original points.
+static uint64_t b3ProxyAbsBound( b3Fixed value )
+{
+	return value < 0 ? 0 - (uint64_t)value : (uint64_t)value;
+}
+
+static bool b3ProxyWideAdmissible( const b3ShapeProxy* proxy, b3Vec3 axis )
+{
+	uint64_t directionBound = b3ProxyAbsBound( axis.x );
+	uint64_t y = b3ProxyAbsBound( axis.y );
+	uint64_t z = b3ProxyAbsBound( axis.z );
+	directionBound = y > directionBound ? y : directionBound;
+	directionBound = z > directionBound ? z : directionBound;
+	uint64_t operandBound = 0;
+	b3Vec3 origin = proxy->points[0];
+	for ( int i = 1; i < proxy->count; ++i )
+	{
+		b3Vec3 delta = b3Sub( proxy->points[i], origin );
+		uint64_t x = b3ProxyAbsBound( delta.x );
+		y = b3ProxyAbsBound( delta.y );
+		z = b3ProxyAbsBound( delta.z );
+		operandBound = x > operandBound ? x : operandBound;
+		operandBound = y > operandBound ? y : operandBound;
+		operandBound = z > operandBound ? z : operandBound;
+	}
+#if defined( B3_SIMD_NEON )
+	if ( directionBound >= ( (uint64_t)1 << 31 ) || operandBound >= ( (uint64_t)1 << 31 ) )
+	{
+		return false;
+	}
+#endif
+	// Reserve the rounding half-quantum too; the vector add must not overflow.
+	if ( directionBound == 0 )
+	{
+		return true;
+	}
+	const uint64_t productLimit = ( ( UINT64_MAX >> 1 ) - (uint64_t)( B3_FIXED_ONE / 2 ) ) / 3;
+	return operandBound <= productLimit / directionBound;
+}
