+static const uint8_t b3ProxyPickX[16] = { 0, 1, 2, 3, 12, 13, 14, 15, 24, 25, 26, 27, 36, 37, 38, 39 };
+static const uint8_t b3ProxyPickY[16] = { 4, 5, 6, 7, 16, 17, 18, 19, 28, 29, 30, 31, 40, 41, 42, 43 };
+static const uint8_t b3ProxyPickZ[16] = { 8, 9, 10, 11, 20, 21, 22, 23, 32, 33, 34, 35, 44, 45, 46, 47 };
+
+static int b3GetProxySupportWide( const b3ShapeProxy* proxy, b3Vec3 axis )
+{
+	b3Vec3 origin = proxy->points[0];
+	int groups = proxy->count / 4;
+	int32x2_t ax = vdup_n_s32( (int32_t)axis.x );
+	int32x2_t ay = vdup_n_s32( (int32_t)axis.y );
+	int32x2_t az = vdup_n_s32( (int32_t)axis.z );
+	int32x4_t ox = vdupq_n_s32( (int32_t)origin.x );
+	int32x4_t oy = vdupq_n_s32( (int32_t)origin.y );
+	int32x4_t oz = vdupq_n_s32( (int32_t)origin.z );
+	uint8x16_t pickX = vld1q_u8( b3ProxyPickX );
+	uint8x16_t pickY = vld1q_u8( b3ProxyPickY );
+	uint8x16_t pickZ = vld1q_u8( b3ProxyPickZ );
+	int64x2_t bestLo = vdupq_n_s64( 0 ), bestHi = vdupq_n_s64( 0 );
+	int64x2_t bestIdxLo = vdupq_n_s64( 0 ), bestIdxHi = vdupq_n_s64( 0 );
+	const int64_t firstLo[2] = { 0, 1 }, firstHi[2] = { 2, 3 };
+	int64x2_t curLo = vld1q_s64( firstLo ), curHi = vld1q_s64( firstHi );
+	int64x2_t four = vdupq_n_s64( 4 );
+	const b3Fixed* fields = (const b3Fixed*)proxy->points;
+	for ( int group = 0; group < groups; ++group )
+	{
+		const b3Fixed* f = fields + 12 * group;
+		int32x4_t c01 = vuzp1q_s32( vreinterpretq_s32_s64( vld1q_s64( f + 0 ) ), vreinterpretq_s32_s64( vld1q_s64( f + 2 ) ) );
+		int32x4_t c23 = vuzp1q_s32( vreinterpretq_s32_s64( vld1q_s64( f + 4 ) ), vreinterpretq_s32_s64( vld1q_s64( f + 6 ) ) );
+		int32x4_t c45 = vuzp1q_s32( vreinterpretq_s32_s64( vld1q_s64( f + 8 ) ), vreinterpretq_s32_s64( vld1q_s64( f + 10 ) ) );
+		uint8x16x3_t table;
+		table.val[0] = vreinterpretq_u8_s32( c01 );
+		table.val[1] = vreinterpretq_u8_s32( c23 );
+		table.val[2] = vreinterpretq_u8_s32( c45 );
+		// Modulo-32 subtraction reconstructs each admitted int32 difference,
+		// even when the original point and origin both lie far from zero.
+		int32x4_t vx = vsubq_s32( vreinterpretq_s32_u8( vqtbl3q_u8( table, pickX ) ), ox );
+		int32x4_t vy = vsubq_s32( vreinterpretq_s32_u8( vqtbl3q_u8( table, pickY ) ), oy );
+		int32x4_t vz = vsubq_s32( vreinterpretq_s32_u8( vqtbl3q_u8( table, pickZ ) ), oz );
+		int64x2_t lo = vmull_s32( vget_low_s32( vx ), ax );
+		lo = vmlal_s32( lo, vget_low_s32( vy ), ay );
+		lo = vmlal_s32( lo, vget_low_s32( vz ), az );
+		int64x2_t hi = vmull_s32( vget_high_s32( vx ), ax );
+		hi = vmlal_s32( hi, vget_high_s32( vy ), ay );
+		hi = vmlal_s32( hi, vget_high_s32( vz ), az );
+		lo = vshrq_n_s64( vaddq_s64( lo, vdupq_n_s64( B3_FIXED_ONE / 2 ) ), 16 );
+		hi = vshrq_n_s64( vaddq_s64( hi, vdupq_n_s64( B3_FIXED_ONE / 2 ) ), 16 );
+		uint64x2_t gtLo = vcgtq_s64( lo, bestLo );
+		uint64x2_t gtHi = vcgtq_s64( hi, bestHi );
+		bestLo = vbslq_s64( gtLo, lo, bestLo );
+		bestHi = vbslq_s64( gtHi, hi, bestHi );
+		bestIdxLo = vbslq_s64( gtLo, curLo, bestIdxLo );
+		bestIdxHi = vbslq_s64( gtHi, curHi, bestIdxHi );
+		curLo = vaddq_s64( curLo, four );
+		curHi = vaddq_s64( curHi, four );
+	}
+	int64_t values[4], indices[4];
+	vst1q_s64( values, bestLo );
+	vst1q_s64( values + 2, bestHi );
+	vst1q_s64( indices, bestIdxLo );
+	vst1q_s64( indices + 2, bestIdxHi );
+	int bestIndex = 0;
+	b3Fixed best = 0;
+	for ( int lane = 0; lane < 4; ++lane )
+	{
+		if ( values[lane] > best || ( values[lane] == best && indices[lane] < bestIndex ) )
+		{
+			best = values[lane];
+			bestIndex = (int)indices[lane];
+		}
+	}
+	for ( int i = groups * 4; i < proxy->count; ++i )
+	{
+		b3Fixed projection = b3Dot( axis, b3Sub( proxy->points[i], origin ) );
+		if ( projection > best )
+		{
+			best = projection;
+			bestIndex = i;
+		}
+	}
+	return bestIndex;
+}
