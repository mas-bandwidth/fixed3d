+static int b3GetProxySupportWide( const b3ShapeProxy* proxy, b3Vec3 axis )
+{
+	const __m256i dirX = _mm256_set1_epi64x( axis.x );
+	const __m256i dirY = _mm256_set1_epi64x( axis.y );
+	const __m256i dirZ = _mm256_set1_epi64x( axis.z );
+	const b3Vec3 origin = proxy->points[0];
+	const __m256i originX = _mm256_set1_epi64x( origin.x );
+	const __m256i originY = _mm256_set1_epi64x( origin.y );
+	const __m256i originZ = _mm256_set1_epi64x( origin.z );
+	const __m256i pickX0 = _mm256_setr_epi64x( 0, 3, 6, 6 );
+	const __m256i pickX1 = _mm256_setr_epi64x( 0, 1, 2, 5 );
+	const __m256i pickY0 = _mm256_setr_epi64x( 1, 4, 7, 7 );
+	const __m256i pickY1 = _mm256_setr_epi64x( 0, 1, 2, 6 );
+	const __m256i pickZ0 = _mm256_setr_epi64x( 2, 5, 5, 5 );
+	const __m256i pickZ1 = _mm256_setr_epi64x( 0, 1, 4, 7 );
+	const __m256i half = _mm256_set1_epi64x( B3_FIXED_ONE / 2 );
+	__m256i bestVal = _mm256_setzero_si256();
+	__m256i bestIdx = _mm256_setzero_si256();
+	__m256i curIdx = _mm256_setr_epi64x( 0, 1, 2, 3 );
+	const __m256i four = _mm256_set1_epi64x( 4 );
+	int groups = proxy->count / 4;
+	const b3Fixed* fields = (const b3Fixed*)proxy->points;
+	for ( int group = 0; group < groups; ++group )
+	{
+		const b3Fixed* f = fields + 12 * group;
+		__m256i r0 = _mm256_loadu_si256( (const __m256i*)( f + 0 ) );
+		__m256i r1 = _mm256_loadu_si256( (const __m256i*)( f + 4 ) );
+		__m256i r2 = _mm256_loadu_si256( (const __m256i*)( f + 8 ) );
+		__m256i px = _mm256_sub_epi64( _mm256_permutex2var_epi64( _mm256_permutex2var_epi64( r0, pickX0, r1 ), pickX1, r2 ), originX );
+		__m256i py = _mm256_sub_epi64( _mm256_permutex2var_epi64( _mm256_permutex2var_epi64( r0, pickY0, r1 ), pickY1, r2 ), originY );
+		__m256i pz = _mm256_sub_epi64( _mm256_permutex2var_epi64( _mm256_permutex2var_epi64( r0, pickZ0, r1 ), pickZ1, r2 ), originZ );
+		__m256i dot = _mm256_add_epi64( _mm256_add_epi64( _mm256_mullo_epi64( dirX, px ), _mm256_mullo_epi64( dirY, py ) ),
+			_mm256_mullo_epi64( dirZ, pz ) );
+		__m256i rounded = _mm256_srai_epi64( _mm256_add_epi64( dot, half ), 16 );
+		__mmask8 greater = _mm256_cmpgt_epi64_mask( rounded, bestVal );
+		bestVal = _mm256_mask_blend_epi64( greater, bestVal, rounded );
+		bestIdx = _mm256_mask_blend_epi64( greater, bestIdx, curIdx );
+		curIdx = _mm256_add_epi64( curIdx, four );
+	}
+	b3Fixed values[4];
+	int64_t indices[4];
+	_mm256_storeu_si256( (__m256i*)values, bestVal );
+	_mm256_storeu_si256( (__m256i*)indices, bestIdx );
+	int bestIndex = 0;
+	b3Fixed best = 0;
+	for ( int lane = 0; lane < 4; ++lane )
+	{
+		if ( values[lane] > best || ( values[lane] == best && indices[lane] < bestIndex ) )
+		{
+			best = values[lane];
+			bestIndex = (int)indices[lane];
+		}
+	}
+	for ( int i = groups * 4; i < proxy->count; ++i )
+	{
+		b3Fixed projection = b3Dot( axis, b3Sub( proxy->points[i], origin ) );
+		if ( projection > best )
+		{
+			best = projection;
+			bestIndex = i;
+		}
+	}
+	return bestIndex;
+}
+#elif defined( B3_SIMD_NEON )
+#include <arm_neon.h>
