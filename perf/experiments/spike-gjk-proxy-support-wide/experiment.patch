+// Independent scalar oracle for the rounded, origin-shifted proxy scan.
+static int ProxySupportScalarOracle( const b3ShapeProxy* proxy, b3Vec3 axis, b3Fixed* value )
+{
+	const b3Vec3 origin = proxy->points[0];
+	int bestIndex = 0;
+	b3Fixed best = 0;
+	for ( int i = 1; i < proxy->count; ++i )
+	{
+		b3Fixed projection = b3Dot( axis, b3Sub( proxy->points[i], origin ) );
+		if ( projection > best )
+		{
+			best = projection;
+			bestIndex = i;
+		}
+	}
+	*value = best;
+	return bestIndex;
+}
+
+static uint32_t ProxySupportNextRandom( uint32_t* seed )
+{
+	uint32_t x = *seed;
+	x ^= x << 13;
+	x ^= x >> 17;
+	x ^= x << 5;
+	*seed = x;
+	return x;
+}
+
+static int ProxySupportWideEquivalenceTest( void )
+{
+	// Raw dots 32768 and 65536 differ, but both round to one Q16 quantum.
+	// A raw-dot argmax would pick index 2; the scalar first-wins answer is 1.
+	b3Vec3 roundedTie[8] = { { 0, 0, 0 }, { 1, 0, 0 }, { 2, 0, 0 } };
+	b3ShapeProxy tieProxy = { roundedTie, 8, 0 };
+	b3Vec3 tieAxis = { B3_FIXED_ONE / 2, 0, 0 };
+	b3Fixed tieValue;
+	ENSURE( ProxySupportScalarOracle( &tieProxy, tieAxis, &tieValue ) == 1 );
+	ENSURE( b3GetProxySupport( &tieProxy, tieAxis ) == 1 );
+	ENSURE( tieValue == 1 );
+
+	const int counts[] = { 8, 20, 64, 128 };
+	b3Vec3 points[128];
+	uint32_t seed = 0x195c4e27u;
+	for ( int shape = 0; shape < 4; ++shape )
+	{
+		int count = counts[shape];
+		for ( int i = 0; i < count; ++i )
+		{
+			points[i] = (b3Vec3){ (b3Fixed)( (int32_t)( ProxySupportNextRandom( &seed ) % 200001 ) - 100000 ),
+				(b3Fixed)( (int32_t)( ProxySupportNextRandom( &seed ) % 200001 ) - 100000 ),
+				(b3Fixed)( (int32_t)( ProxySupportNextRandom( &seed ) % 200001 ) - 100000 ) };
+			if ( shape == 3 )
+			{
+				// Large common translations must cancel before the int32 gate.
+				points[i].x += (b3Fixed)1 << 40;
+				points[i].y -= (b3Fixed)1 << 39;
+			}
+		}
+		// Duplicate vertices give exact value ties in the 3D seeded hulls.
+		points[1] = points[0];
+		points[2].x = ( shape == 3 ? (b3Fixed)1 << 40 : 0 ) + 200001;
+		points[2].y = shape == 3 ? -( (b3Fixed)1 << 39 ) : 0;
+		points[3] = points[2];
+		points[count - 1] = points[count - 2];
+		b3ShapeProxy proxy = { points, count, 0 };
+		for ( int trial = 0; trial < 25000; ++trial )
+		{
+			b3Vec3 axis = { (b3Fixed)( (int32_t)( ProxySupportNextRandom( &seed ) % 4000001 ) - 2000000 ),
+				(b3Fixed)( (int32_t)( ProxySupportNextRandom( &seed ) % 4000001 ) - 2000000 ),
+				(b3Fixed)( (int32_t)( ProxySupportNextRandom( &seed ) % 4000001 ) - 2000000 ) };
+			if ( trial % 127 == 0 )
+			{
+				axis = (b3Vec3){ 0, 0, B3_FIXED_ONE };
+			}
+			else if ( trial % 127 == 1 )
+			{
+				axis = (b3Vec3){ 0, 0, 0 };
+			}
+			else if ( trial % 127 == 2 )
+			{
+				axis = (b3Vec3){ (b3Fixed)1 << 57, -( (b3Fixed)1 << 56 ), 7 };
+			}
+			else if ( trial % 127 == 3 )
+			{
+				axis = (b3Vec3){ B3_FIXED_ONE, 0, 0 };
+			}
+			b3Fixed scalarValue;
+			int scalarIndex = ProxySupportScalarOracle( &proxy, axis, &scalarValue );
+			int wideIndex = b3GetProxySupport( &proxy, axis );
+			b3Fixed wideValue = b3Dot( axis, b3Sub( points[wideIndex], points[0] ) );
+			ENSURE( wideIndex == scalarIndex );
+			ENSURE( wideValue == scalarValue );
+		}
+	}
+	return 0;
+}
