diff --git a/test/test_math.c b/test/test_math.c
index a881d24..a91dac5 100644
--- a/test/test_math.c
+++ b/test/test_math.c
@@ -8,6 +8,40 @@
 #include <math.h>
 #include <stdio.h>
 
+#if defined( __AVX2__ )
+#include "../benchmark/avx2_lane_mul.h"
+
+// Unit tier for the archived AVX2 experiment: seeded and edge inputs, no clock.
+int Avx2LaneMulEquivalenceTest( void )
+{
+	static const int64_t edge[] = { INT64_MIN, INT64_MIN + 1, -INT64_C(0x10000), -1,
+		0, 1, INT64_C(0x7fff), INT64_C(0x8000), INT64_C(0x10000), INT64_MAX - 1, INT64_MAX };
+	uint64_t state = UINT64_C(0x9e3779b97f4a7c15);
+	for ( int batch = 0; batch < 25000; ++batch )
+	{
+		int64_t a[4], b[4], got[4];
+		for ( int lane = 0; lane < 4; ++lane )
+		{
+			int k = batch * 4 + lane;
+			state ^= state >> 12; state ^= state << 25; state ^= state >> 27;
+			a[lane] = (int64_t)(state * UINT64_C(2685821657736338717));
+			state ^= state >> 12; state ^= state << 25; state ^= state >> 27;
+			b[lane] = (int64_t)(state * UINT64_C(2685821657736338717));
+			if ( k < (int)( sizeof(edge)/sizeof(edge[0]) ) * (int)( sizeof(edge)/sizeof(edge[0]) ) )
+			{
+				a[lane] = edge[k / (int)( sizeof(edge)/sizeof(edge[0]) )];
+				b[lane] = edge[k % (int)( sizeof(edge)/sizeof(edge[0]) )];
+			}
+		}
+		__m256i va = _mm256_loadu_si256( (const __m256i*)a );
+		__m256i vb = _mm256_loadu_si256( (const __m256i*)b );
+		_mm256_storeu_si256( (__m256i*)got, b3Avx2MulLanes( va, vb ) );
+		for ( int lane = 0; lane < 4; ++lane ) ENSURE( got[lane] == b3FixMul( a[lane], b[lane] ) );
+	}
+	return 0;
+}
+#endif
+
 // The minimax polynomial is accurate to 0.0023 degrees (4e-5 radians); add the
 // Q48.16 output resolution (1.5e-5) on top.
 #define ATAN_TOL B3_FIX( 0.0001f )
