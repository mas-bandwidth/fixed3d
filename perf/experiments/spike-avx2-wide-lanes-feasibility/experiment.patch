diff --git a/benchmark/avx2_lane_mul.c b/benchmark/avx2_lane_mul.c
new file mode 100644
index 0000000..fdbd25f
--- /dev/null
+++ b/benchmark/avx2_lane_mul.c
@@ -0,0 +1,135 @@
+// Standalone AVX2 feasibility microbenchmark. Build only on an AVX2 Linux host:
+// cc -O3 -flto -std=c17 -mavx2 -Iinclude -Iextern/fixed/include benchmark/avx2_lane_mul.c -o avx2_lane_mul
+#define _POSIX_C_SOURCE 200809L
+#include "avx2_lane_mul.h"
+#include "box3d/base.h"
+#include "box3d/fixed_compat.h"
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+#define PAIRS UINT64_C(25000000)
+#define INPUTS 16384
+#define LOOPS 256
+#define RUNS 7
+
+static uint64_t state = UINT64_C(0x9e3779b97f4a7c15);
+static uint64_t next64( void )
+{
+	state ^= state >> 12;
+	state ^= state << 25;
+	state ^= state >> 27;
+	return state * UINT64_C(2685821657736338717);
+}
+
+static double now_ns( void )
+{
+	struct timespec t;
+	if ( clock_gettime( CLOCK_MONOTONIC_RAW, &t ) != 0 ) abort();
+	return (double)t.tv_sec * 1000000000.0 + (double)t.tv_nsec;
+}
+
+static int cmp_double( const void* a, const void* b )
+{
+	double x = *(const double*)a, y = *(const double*)b;
+	return (x > y) - (x < y);
+}
+
+__attribute__((noinline)) static uint64_t scalar_kernel( const int64_t* a, const int64_t* b )
+{
+	uint64_t checksum = 0;
+	for ( int loop = 0; loop < LOOPS; ++loop )
+	{
+		uint64_t salt = (uint64_t)loop * UINT64_C(0x9e3779b97f4a7c15);
+		for ( int i = 0; i < INPUTS; ++i )
+			checksum ^= (uint64_t)b3FixMul( (int64_t)((uint64_t)a[i] ^ salt), b[i] );
+	}
+	return checksum;
+}
+
+__attribute__((noinline)) static uint64_t avx2_kernel( const int64_t* a, const int64_t* b )
+{
+	__m256i checksum = _mm256_setzero_si256();
+	for ( int loop = 0; loop < LOOPS; ++loop )
+	{
+		__m256i salt = _mm256_set1_epi64x( (int64_t)( (uint64_t)loop * UINT64_C(0x9e3779b97f4a7c15) ) );
+		for ( int i = 0; i < INPUTS; i += 4 )
+		{
+			__m256i va = _mm256_xor_si256( _mm256_loadu_si256( (const __m256i*)( a + i ) ), salt );
+			__m256i vb = _mm256_loadu_si256( (const __m256i*)( b + i ) );
+			checksum = _mm256_xor_si256( checksum, b3Avx2MulLanes( va, vb ) );
+		}
+	}
+	int64_t lanes[4];
+	_mm256_storeu_si256( (__m256i*)lanes, checksum );
+	return (uint64_t)lanes[0] ^ (uint64_t)lanes[1] ^ (uint64_t)lanes[2] ^ (uint64_t)lanes[3];
+}
+
+int main( void )
+{
+	static const int64_t edges[] = {
+		INT64_MIN, INT64_MIN + 1, -INT64_C(0x100000000), -INT64_C(0x10000),
+		-INT64_C(0x8000), -1, 0, 1, INT64_C(0x7fff), INT64_C(0x8000),
+		INT64_C(0xffff), INT64_C(0x10000), INT64_C(0x100000000), INT64_MAX - 1, INT64_MAX
+	};
+	const uint64_t edge_count = sizeof(edges)/sizeof(edges[0]);
+	const uint64_t edge_pairs = edge_count * edge_count;
+	uint64_t mismatches = 0;
+	for ( uint64_t i = 0; i < PAIRS; i += 4 )
+	{
+		int64_t a[4], b[4], got[4];
+		for ( int lane = 0; lane < 4; ++lane )
+		{
+			uint64_t index = i + (uint64_t)lane;
+			if ( index < edge_pairs )
+			{
+				a[lane] = edges[index / edge_count];
+				b[lane] = edges[index % edge_count];
+			}
+			else { a[lane] = (int64_t)next64(); b[lane] = (int64_t)next64(); }
+		}
+		__m256i va = _mm256_loadu_si256( (const __m256i*)a );
+		__m256i vb = _mm256_loadu_si256( (const __m256i*)b );
+		_mm256_storeu_si256( (__m256i*)got, b3Avx2MulLanes( va, vb ) );
+		for ( int lane = 0; lane < 4; ++lane )
+		{
+			int64_t want = b3FixMul( a[lane], b[lane] );
+			if ( got[lane] != want )
+			{
+				if ( mismatches < 4 ) fprintf( stderr, "mismatch pair=%" PRIu64 " a=%" PRId64 " b=%" PRId64 " got=%" PRId64 " want=%" PRId64 "\n", i+(uint64_t)lane, a[lane], b[lane], got[lane], want );
+				++mismatches;
+			}
+		}
+	}
+	printf( "differential pairs=%" PRIu64 " edges=%" PRIu64 " random=%" PRIu64 " mismatches=%" PRIu64 "\n", PAIRS, edge_pairs, PAIRS-edge_pairs, mismatches );
+	if ( mismatches ) return 1;
+
+	int64_t *a = malloc( INPUTS * sizeof(*a) ), *b = malloc( INPUTS * sizeof(*b) );
+	if ( !a || !b ) return 2;
+	for ( int i = 0; i < INPUTS; ++i ) { a[i] = (int64_t)next64(); b[i] = (int64_t)next64(); }
+	volatile uint64_t sink = scalar_kernel( a, b ) ^ avx2_kernel( a, b );
+	double scalar[RUNS], avx2[RUNS];
+	for ( int run = 0; run < RUNS; ++run )
+	{
+		double t0, t1;
+		if ( run & 1 )
+		{
+			t0 = now_ns(); sink ^= avx2_kernel( a, b ); t1 = now_ns(); avx2[run] = (t1-t0)/(INPUTS*LOOPS);
+			t0 = now_ns(); sink ^= scalar_kernel( a, b ); t1 = now_ns(); scalar[run] = (t1-t0)/(INPUTS*LOOPS);
+		}
+		else
+		{
+			t0 = now_ns(); sink ^= scalar_kernel( a, b ); t1 = now_ns(); scalar[run] = (t1-t0)/(INPUTS*LOOPS);
+			t0 = now_ns(); sink ^= avx2_kernel( a, b ); t1 = now_ns(); avx2[run] = (t1-t0)/(INPUTS*LOOPS);
+		}
+		printf( "pass=%d scalar_ns_per_mul=%.4f avx2_ns_per_mul=%.4f speedup=%.4f\n", run+1, scalar[run], avx2[run], scalar[run]/avx2[run] );
+	}
+	qsort( scalar, RUNS, sizeof(double), cmp_double );
+	qsort( avx2, RUNS, sizeof(double), cmp_double );
+	printf( "scalar min=%.4f median=%.4f spread=%.4f ns/mul\n", scalar[0], scalar[RUNS/2], scalar[RUNS-1]-scalar[0] );
+	printf( "avx2 min=%.4f median=%.4f spread=%.4f ns/mul\n", avx2[0], avx2[RUNS/2], avx2[RUNS-1]-avx2[0] );
+	printf( "median_speedup=%.4f sink=%" PRIu64 "\n", scalar[RUNS/2]/avx2[RUNS/2], sink );
+	free( a ); free( b );
+	return 0;
+}
diff --git a/benchmark/avx2_lane_mul.h b/benchmark/avx2_lane_mul.h
new file mode 100644
index 0000000..5ccaa18
--- /dev/null
+++ b/benchmark/avx2_lane_mul.h
@@ -0,0 +1,30 @@
+// Experimental AVX2 Q48.16 four-lane multiply. Artifact for feasibility spike.
+#pragma once
+#include <immintrin.h>
+#include <stdint.h>
+
+// Compute bits 16..79 of signed a*b+0x8000, matching wrapping b3FixMul.
+// Four unsigned 32x32->64 products reconstruct the unsigned 64x64 product;
+// sign corrections affect only the high 16 output bits. All additions wrap.
+static inline __m256i b3Avx2MulLanes( __m256i a, __m256i b )
+{
+	const __m256i mask32 = _mm256_set1_epi64x( INT64_C( 0xffffffff ) );
+	const __m256i mask16 = _mm256_set1_epi64x( INT64_C( 0xffff ) );
+	const __m256i half = _mm256_set1_epi64x( INT64_C( 0x8000 ) );
+	const __m256i zero = _mm256_setzero_si256();
+	__m256i ah = _mm256_srli_epi64( a, 32 );
+	__m256i bh = _mm256_srli_epi64( b, 32 );
+	__m256i p00 = _mm256_mul_epu32( a, b );
+	__m256i p01 = _mm256_mul_epu32( a, bh );
+	__m256i p10 = _mm256_mul_epu32( ah, b );
+	__m256i p11 = _mm256_mul_epu32( ah, bh );
+	__m256i low = _mm256_srli_epi64( _mm256_add_epi64( _mm256_and_si256( p00, mask32 ), half ), 16 );
+	__m256i cross = _mm256_add_epi64( _mm256_srli_epi64( p00, 32 ), _mm256_add_epi64( p01, p10 ) );
+	__m256i sign_a = _mm256_cmpgt_epi64( zero, a );
+	__m256i sign_b = _mm256_cmpgt_epi64( zero, b );
+	__m256i correction = _mm256_add_epi64( _mm256_and_si256( sign_a, _mm256_and_si256( b, mask16 ) ),
+		_mm256_and_si256( sign_b, _mm256_and_si256( a, mask16 ) ) );
+	__m256i high = _mm256_sub_epi64( p11, correction );
+	return _mm256_add_epi64( low,
+		_mm256_add_epi64( _mm256_slli_epi64( cross, 16 ), _mm256_slli_epi64( high, 48 ) ) );
+}
